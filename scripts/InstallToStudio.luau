    local s = Instance.new("ModuleScript")
    s.Name = "DroneConfig"
    s.Source = "--!strict\n-- DroneConfig.luau\n-- Global configuration parameters for Drone Flight & Swarm Show Simulation\n\n-- Simulation sites. ACTIVE_SITE picks the launch pad (HOME) the drone starts from.\n-- Real-world sites are built from OpenStreetMap (tools/osm2roblox.py -> scripts/maps/) and carry the\n-- launch pad's GPS position so exported flights can be placed exactly where they were simulated.\nlocal SITES = {\n\t-- Fictional Bosphorus demo map (scripts/BuildIstanbulMap.luau) \u2014 NOT to scale\n\t-- SHOW_CENTER: ground point the swarm light show is built around; SHOW_LIFT: extra studs so the\n\t-- formations clear the rooftops (real map buildings reach ~30 m)\n\tISTANBUL_DEMO = {\n\t\tHOME = Vector3.new(-220, 4.0, 0),\n\t\tHOME_GEO = nil :: { number }?,\n\t\tWEATHER_GEO = { 41.045, 29.034 },\n\t\tSHOW_CENTER = Vector3.new(0, 0, 0),\n\t\tSHOW_LIFT = 0,\n\t},\n\t-- Real Bah\u00e7elievler around the state hospital, map origin (6000, 0, 0); pad from osm2roblox\n\t-- HOME_GEO = { lat, lon, ground m AMSL } of the pad (SRTM terrain; 0.7 stud = pad + landing gear)\n\tBAHCELIEVLER = {\n\t\tHOME = Vector3.new(6000 - 273.7, 33.2 + 0.7, -115.8),\n\t\tHOME_GEO = { 41.0065415, 28.8434376, 34.8 },\n\t\tWEATHER_GEO = { 41.0065415, 28.8434376 },\n\t\tSHOW_CENTER = Vector3.new(6000 - 273.7, 33.2, -115.8 - 60), -- over the pad, 17 m north\n\t\tSHOW_LIFT = 30 * 3.5, -- 30 m above the pad, below the 100 m fence ceiling\n\t},\n}\nlocal ACTIVE_SITE = \"BAHCELIEVLER\"\n\nlocal DroneConfig = {\n\t-- World & Physics Scale\n\t-- In Roblox, standard scale: 1 stud \u2248 0.28 meters (or 1 stud = 0.5m in custom flight models).\n\t-- Here we define conversion factor for real-world drone translation:\n\tSTUDS_PER_METER = 3.5, -- ~0.285m per stud\n\n\t-- Physical Drone Properties\n\tDRONE_MODEL = {\n\t\tFRAME_SIZE = Vector3.new(2.4, 0.5, 2.4), -- Studs (X, Y, Z)\n\t\tBODY_COLOR = Color3.fromRGB(30, 30, 35),\n\t\tROTOR_RADIUS = 0.7,\n\t\tROTOR_RPM = 4800,\n\t\tLED_DEFAULT_COLOR = Color3.fromRGB(0, 255, 120), -- Neon Green\n\t\tLED_BRIGHTNESS = 2.0,\n\t\tCOLLISION_RADIUS = 2.0, -- Minimum distance between drones (studs)\n\t},\n\n\t-- Flight Kinematics & Limits (Real drone physical limits)\n\tFLIGHT = {\n\t\tMAX_HORIZONTAL_SPEED = 20.0, -- studs/sec (~6 m/s)\n\t\tMAX_CLIMB_SPEED = 12.0,      -- studs/sec (~3.5 m/s)\n\t\tMAX_DESCENT_SPEED = 8.0,     -- studs/sec (~2.3 m/s)\n\t\tMAX_ACCELERATION = 15.0,     -- studs/sec^2\n\t\tMAX_TILT_ANGLE = 30.0,       -- degrees (pitch/roll when moving fast)\n\t\tMAX_YAW_RATE = 120.0,        -- degrees/sec\n\t\tTAKEOFF_ALTITUDE = 15.0,     -- Default hover altitude above ground\n\t\tRETURN_TO_HOME_ALT = 25.0,   -- Safe transit altitude\n\t},\n\n\t-- Swarm Performance (Supports up to 800+ drones)\n\tSWARM = {\n\t\tMAX_DRONES = 800,\n\t\tMIN_SEPARATION_M = 2.0,      -- closer than this = collision risk (plan_show.py --min-sep; RTK show drones)\n\t\tBATCH_UPDATE_SIZE = 100,     -- Chunk size for BulkMoveTo\n\t\tUSE_CLIENT_INTERPOLATION = true,\n\t\tSYNC_RATE_HZ = 30,           -- Network replication frequency (Server -> Client)\n\t\tSIMULATION_STEP_DT = 1 / 60, -- 60 FPS physics tick\n\t},\n\n\t-- Visual & LED Show Settings\n\tLIGHT_SHOW = {\n\t\tENABLE_TRAILS = true,\n\t\tTRAIL_LIFETIME = 0.8,\n\t\tCOLOR_PALETTES = {\n\t\t\tCYAN_PINK = { Color3.fromRGB(0, 255, 255), Color3.fromRGB(255, 0, 128) },\n\t\t\tGOLD_WHITE = { Color3.fromRGB(255, 215, 0), Color3.fromRGB(255, 255, 255) },\n\t\t\tRAINBOW = {\n\t\t\t\tColor3.fromRGB(255, 0, 0),\n\t\t\t\tColor3.fromRGB(255, 127, 0),\n\t\t\t\tColor3.fromRGB(255, 255, 0),\n\t\t\t\tColor3.fromRGB(0, 255, 0),\n\t\t\t\tColor3.fromRGB(0, 0, 255),\n\t\t\t\tColor3.fromRGB(75, 0, 130),\n\t\t\t\tColor3.fromRGB(148, 0, 211),\n\t\t\t},\n\t\t\tTURKISH_FLAG = { Color3.fromRGB(230, 0, 0), Color3.fromRGB(255, 255, 255) },\n\t\t},\n\t},\n\n\t-- Real-drone bridge: every exported flight is expressed relative to this launch point.\n\t-- On the field it is replaced by the drone's real GPS home (tools/sim2mission.py --home).\n\tACTIVE_SITE = ACTIVE_SITE,\n\tHOME = {\n\t\tSIM_POSITION = SITES[ACTIVE_SITE].HOME, -- launch pad (drone resting height)\n\t\tGEO = SITES[ACTIVE_SITE].HOME_GEO, -- { lat, lon, AMSL } of the pad for real-world sites, else nil\n\t\tSHOW_CENTER = SITES[ACTIVE_SITE].SHOW_CENTER,\n\t\tSHOW_LIFT = SITES[ACTIVE_SITE].SHOW_LIFT,\n\t},\n\n\t-- Live weather (server WeatherService). Needs \"Allow HTTP Requests\" in Game Settings > Security.\n\tWEATHER = {\n\t\tMODE = \"LIVE\", -- \"LIVE\" or \"MANUAL\"\n\t\tGEO = SITES[ACTIVE_SITE].WEATHER_GEO,\n\t\t-- Observed wind first: METAR stations nearest to the site (LTBA Atat\u00fcrk ~3 km from Bah\u00e7elievler)\n\t\tMETAR_STATIONS = { \"LTBA\", \"LTFJ\", \"LTFM\" },\n\t\tMETAR_MAX_AGE_MIN = 90,\n\t\tREFRESH_SEC = 600, -- MET Norway asks clients not to poll more often than their data updates\n\t\tMANUAL = { SPEED_MS = 0, FROM_DEG = 0, GUST_MS = 0 },\n\t\t-- Wind profile: 10 m reports (open airport / model grid, z0 ~0.03 m) carried to a 100 m blending\n\t\t-- height, then down again over the city with urban roughness.\n\t\tSOURCE_Z0_M = 0.03,\n\t\tSITE_Z0_M = 1.0,\n\t\tBLEND_HEIGHT_M = 100,\n\t\tTURBULENCE_INTENSITY = 0.25, -- sigma / mean over a city when no gust is reported\n\t\tEDDY_LENGTH_M = 40,\n\t\tSTRONG_WIND_MS = 10, -- panel warning threshold at flight altitude\n\t},\n\n\t-- Airframe & power system: \"TEI F450 Otonom Devriye \u0130HA\" (rasperiypi/ docs): F450 Quad-X,\n\t-- 4x MT2808 (KV unknown), 10\" 3-blade props, Skywalker 30 A PWM ESCs, 4S 5000 mAh,\n\t-- Power Module V1.0, Pixhawk 2.4.8 + Raspberry Pi 5 + IMX500 camera + Storm32 gimbal.\n\t-- Values marked \"est.\" are estimates until measured. Motor numbering follows ArduPilot Quad-X.\n\tAIRFRAME = {\n\t\tMASS_KG = 2.1, -- all-up weight estimate from the build guide\n\t\tMAX_THRUST_PER_MOTOR_N = 9.27, -- guide: thrust/weight ~1.8 -> hover ~55 % (est.)\n\t\tMAX_MOTOR_RPM = 9500, -- est.: MT2808 KV unknown\n\t\tMAX_MOTOR_CURRENT_A = 15.0, -- est.: gives ~26 A hover, ~9 min usable flight\n\t\tAVIONICS_CURRENT_A = 1.5, -- Pixhawk + Pi 5 + IMX500 + GPS + gimbal at 14.8 V (est.)\n\t\tESC_TELEMETRY = false, -- Skywalker PWM ESCs report nothing; per-motor values are estimates\n\t\tRANGEFINDER = false, -- no lidar: landing slows down by barometric altitude above home, not ground height\n\t\tARM_LENGTH_M = 0.225, -- F450: 450 mm motor-to-motor diagonal\n\t\tINERTIA_KGM2 = 0.035,\n\t\tDRAG_COEFF = 0.04, -- m/s\u00b2 per (m/s)\u00b2: ~22\u00b0 lean at 10 m/s (frame + gimbal, est.)\n\t\tMOT_SPIN_ARM = 0.10, -- ArduPilot default idle output when armed\n\t\tAMBIENT_TEMP_C = 22,\n\t\tBATTERY_CELLS = 4,\n\t\tBATTERY_CAPACITY_MAH = 5000,\n\t\tBATTERY_RESISTANCE_OHM = 0.035, -- whole pack\n\t},\n\n\t-- Autopilot behaviour, mirroring ArduPilot Copter 4.6 defaults (converted to meters).\n\t-- Copter 4.7 renames them to SI units (e.g. WPNAV_SPEED -> WP_SPD, RTL_ALT -> RTL_ALT_M).\n\tAUTOPILOT = {\n\t\tWPNAV_SPEED = 6.0,     -- m/s cruise (ArduPilot default 10; tools/make_params.py recommends 6 for the F450)\n\t\tWPNAV_SPEED_UP = 2.5,  -- m/s\n\t\tWPNAV_SPEED_DN = 1.5,  -- m/s\n\t\tWPNAV_ACCEL = 2.5,     -- m/s\u00b2\n\t\tWPNAV_RADIUS = 2.0,    -- m, waypoint reached\n\t\tTAKEOFF_ALT = 5.0,     -- m, same default as tools/sim2mission.py --takeoff-alt\n\t\tRTL_ALT = 30.0,        -- m above home (default 15 would hit 21 m buildings around the Bah\u00e7elievler pad)\n\t\tRTL_LOIT_TIME = 5.0,   -- s hover over home before landing\n\t\tLAND_SPEED = 0.5,      -- m/s final descent\n\t\tLAND_SPEED_HIGH = 1.5, -- m/s above LAND_ALT_LOW (0 in ArduPilot = WPNAV_SPEED_DN)\n\t\tLAND_ALT_LOW = 10.0,   -- m\n\t\tYAW_RATE = 90.0,       -- deg/s\n\t\tANGLE_MAX = 30.0,      -- deg lean limit (ArduPilot default)\n\t\tDISARM_DELAY = 10.0,   -- s on the ground before motors stop (ArduPilot default)\n\t},\n\n\t-- Failsafes (ArduPilot parameter names). Voltages are the usual 3.5 / 3.3 V-per-cell setup,\n\t-- not ArduPilot defaults (BATT_LOW_VOLT defaults to 10.5 V) \u2014 set them on the real drone too.\n\tFAILSAFE = {\n\t\tBATT_LOW_VOLT = 14.0,  -- 3.5 V/cell -> RTL\n\t\tBATT_CRT_VOLT = 13.2,  -- 3.3 V/cell -> LAND\n\t\tBATT_LOW_TIMER = 10.0, -- s below the threshold before acting\n\t\tFENCE_RADIUS = 300.0,  -- m from home -> RTL\n\t\tFENCE_ALT_MAX = 100.0, -- m above home -> RTL (SHGM ceiling is 120 m)\n\t\tFENCE_MARGIN = 2.0,    -- m: manual flight is stopped this far inside the fence (ArduPilot AVOID/FENCE_MARGIN)\n\t\tCRASH_SPEED = 3.0,     -- m/s: touching anything faster than this is a crash\n\t},\n\n\t-- GPS / position estimate (M8N + ArduPilot EKF). The autopilot flies on this estimate, not the true position.\n\tGPS = {\n\t\tENABLED = true,\n\t\tSIGMA_H_M = 0.7,     -- open-sky horizontal wander (1 sigma)\n\t\tSIGMA_V_M = 0.4,     -- barometric altitude drift\n\t\tTAU_S = 30,          -- how slowly the error wanders\n\t\tSATS_OPEN = 14,\n\t\tHDOP_OPEN = 0.8,\n\t\tGLITCH_RATE = 0.08,  -- multipath jumps per second at full obstruction\n\t\tGLITCH_M = { 2, 6 }, -- jump size range\n\t\tFAILSAFE_SATS = 6,   -- fewer satellites (or HDOP above FAILSAFE_HDOP) for 3 s -> LAND (EKF failsafe)\n\t\tFAILSAFE_HDOP = 2.5,\n\t},\n\n\t-- Local MAVLink bridge (tools/mavlink_bridge.py): the sim appears to ground stations as ArduCopter.\n\t-- Only reachable from Studio (localhost); needs \"Allow HTTP Requests\".\n\tBRIDGE = {\n\t\tENABLED = true,\n\t\tURL = \"http://127.0.0.1:34874/sim/state\",\n\t\tRATE_HZ = 5, -- Roblox allows ~500 HTTP requests/min per server\n\t\tRETRY_SEC = 3, -- back-off while the bridge is not running\n\t},\n\n\t-- Flight Blackbox Recorder (manual flights -> real drone missions)\n\tRECORDER = {\n\t\tSAMPLE_RATE_HZ = 10,\n\t\tMAX_DURATION_SEC = 900, -- 15 min; longer copies get too big for the clipboard modal\n\t},\n\n\t-- Export Formats\n\tEXPORT = {\n\t\tVERSION = \"1.0\",\n\t\tDEFAULT_FORMAT = \"JSON\", -- Options: \"JSON\", \"CSV\", \"MAVLINK_MISSION\"\n\t}\n}\n\nreturn table.freeze(DroneConfig)\n"
    s.Parent = parent
    print("[DroneInstaller] Installed DroneConfig (ModuleScript)")
end

do
    local parent = game:GetService("ReplicatedStorage")
    local existing = parent:FindFirstChild("FlightMath")
    if existing then existing:Destroy() end
    local s = Instance.new("ModuleScript")
    s.Name = "FlightMath"
    s.Source = "--!strict\n-- FlightMath.luau\n-- Mathematical utilities for Drone trajectory calculation, Splines, Bank angles, and Geo-coordinates.\n\nlocal DroneConfig = require(script.Parent.DroneConfig)\n\nlocal FlightMath = {}\n\n-- Catmull-Rom Spline Interpolation between 4 points\n-- Passes directly through P1 (at t=0) and P2 (at t=1)\nfunction FlightMath.catmullRom(p0: Vector3, p1: Vector3, p2: Vector3, p3: Vector3, t: number): Vector3\n\tlocal t2 = t * t\n\tlocal t3 = t2 * t\n\n\treturn 0.5 * (\n\t\t(2 * p1) +\n\t\t(-p0 + p2) * t +\n\t\t(2 * p0 - 5 * p1 + 4 * p2 - p3) * t2 +\n\t\t(-p0 + 3 * p1 - 3 * p2 + p3) * t3\n\t)\nend\n\n-- Evaluates full path across multiple waypoints at normalized parameter 0 <= u <= 1\nexport type Waypoint = {\n\tPosition: Vector3,\n\tAltitude: number, -- target height\n\tYaw: number?,     -- target yaw in degrees (optional)\n\tWaitTime: number?,-- wait time in seconds (optional)\n\tSpeed: number?,   -- segment target speed (optional)\n\tLedColor: Color3?,-- color for show (optional)\n}\n\n-- Computes total path length by sampling segments\nfunction FlightMath.calculatePathLengths(points: { Vector3 }, samplesPerSegment: number?): ({ number }, number)\n\tlocal samples = samplesPerSegment or 10\n\tlocal segmentLengths: { number } = {}\n\tlocal totalLength = 0\n\n\tif #points < 2 then\n\t\treturn segmentLengths, 0\n\tend\n\n\tfor i = 1, #points - 1 do\n\t\tlocal p0 = points[math.max(1, i - 1)]\n\t\tlocal p1 = points[i]\n\t\tlocal p2 = points[i + 1]\n\t\tlocal p3 = points[math.min(#points, i + 2)]\n\n\t\tlocal segLen = 0\n\t\tlocal prevPos = p1\n\t\tfor s = 1, samples do\n\t\t\tlocal t = s / samples\n\t\t\tlocal pos = FlightMath.catmullRom(p0, p1, p2, p3, t)\n\t\t\tsegLen += (pos - prevPos).Magnitude\n\t\t\tprevPos = pos\n\t\tend\n\t\ttable.insert(segmentLengths, segLen)\n\t\ttotalLength += segLen\n\tend\n\n\treturn segmentLengths, totalLength\nend\n\n-- Sample position and forward direction at arc-length distance `dist` along waypoints\nfunction FlightMath.sampleSplineAtDistance(\n\tpoints: { Vector3 },\n\tsegmentLengths: { number },\n\ttotalLength: number,\n\tdistance: number\n): (Vector3, Vector3)\n\tif #points == 0 then\n\t\treturn Vector3.zero, Vector3.new(0, 0, -1)\n\telseif #points == 1 then\n\t\treturn points[1], Vector3.new(0, 0, -1)\n\tend\n\n\tlocal targetDist = math.clamp(distance, 0, totalLength)\n\tlocal accumulated = 0\n\tlocal targetSegment = 1\n\tlocal localT = 0\n\n\tfor i, len in ipairs(segmentLengths) do\n\t\tif accumulated + len >= targetDist or i == #segmentLengths then\n\t\t\ttargetSegment = i\n\t\t\tlocal rem = targetDist - accumulated\n\t\t\tlocalT = if len > 0 then math.clamp(rem / len, 0, 1) else 0\n\t\t\tbreak\n\t\tend\n\t\taccumulated += len\n\tend\n\n\tlocal p0 = points[math.max(1, targetSegment - 1)]\n\tlocal p1 = points[targetSegment]\n\tlocal p2 = points[targetSegment + 1]\n\tlocal p3 = points[math.min(#points, targetSegment + 2)]\n\n\tlocal pos = FlightMath.catmullRom(p0, p1, p2, p3, localT)\n\n\t-- Compute tangent vector (forward look direction)\n\tlocal deltaT = 0.01\n\tlocal nextPos = FlightMath.catmullRom(p0, p1, p2, p3, math.min(1, localT + deltaT))\n\tlocal forward = (nextPos - pos)\n\tif forward.Magnitude > 0.001 then\n\t\tforward = forward.Unit\n\telse\n\t\tforward = Vector3.new(0, 0, -1)\n\tend\n\n\treturn pos, forward\nend\n\n-- Calculates realistic quadcopter pitch and roll tilt based on velocity/acceleration\nfunction FlightMath.computeDroneTilt(\n\tvelocity: Vector3,\n\tacceleration: Vector3,\n\tbaseCFrame: CFrame\n): CFrame\n\tlocal maxTiltRad = math.rad(DroneConfig.FLIGHT.MAX_TILT_ANGLE)\n\n\t-- Transform acceleration into drone local coordinates\n\tlocal localAcc = baseCFrame:VectorToObjectSpace(acceleration)\n\n\t-- Pitch leans forward when accelerating forward (along -Z), leans back when braking\n\tlocal pitch = math.clamp(-localAcc.Z * 0.05, -maxTiltRad, maxTiltRad)\n\t-- Roll leans sideways when accelerating laterally (along +X)\n\tlocal roll = math.clamp(-localAcc.X * 0.05, -maxTiltRad, maxTiltRad)\n\n\treturn CFrame.Angles(pitch, 0, roll)\nend\n\n-- Convert Roblox Vector3 (Studs, Y-up) to Real-World Drone Metric Coordinates (Meters, Z-up ENU)\nfunction FlightMath.studsToMetersENU(pos: Vector3, origin: Vector3?): Vector3\n\tlocal ref = origin or Vector3.zero\n\tlocal rel = pos - ref\n\tlocal scale = 1 / DroneConfig.STUDS_PER_METER\n\n\t-- Roblox: X=East, Y=Altitude/Up, Z=South (-Z=North)\n\tlocal east = rel.X * scale\n\tlocal north = -rel.Z * scale\n\tlocal up = rel.Y * scale\n\n\treturn Vector3.new(east, north, up)\nend\n\n-- Convert Real-World Metric (Meters ENU) to Roblox Vector3 (Studs, Y-up)\nfunction FlightMath.metersENUToStuds(enu: Vector3, origin: Vector3?): Vector3\n\tlocal ref = origin or Vector3.zero\n\tlocal scale = DroneConfig.STUDS_PER_METER\n\n\tlocal x = enu.X * scale\n\tlocal y = enu.Z * scale\n\tlocal z = -enu.Y * scale\n\n\treturn ref + Vector3.new(x, y, z)\nend\n\nreturn table.freeze(FlightMath)\n"
    s.Parent = parent
    print("[DroneInstaller] Installed FlightMath (ModuleScript)")
end

do
    local parent = game:GetService("ReplicatedStorage")
    local existing = parent:FindFirstChild("FormationGenerator")
    if existing then existing:Destroy() end
    local s = Instance.new("ModuleScript")
    s.Name = "FormationGenerator"
    s.Source = "--!strict\n-- FormationGenerator.luau\n-- Pre-calculated 3D Swarm Formations for up to 800+ Light Show Drones\n\nlocal DroneConfig = require(script.Parent.DroneConfig)\n\nlocal FormationGenerator = {}\n\nexport type DroneTarget = {\n\tDroneId: number,\n\tTargetPosition: Vector3,\n\tTargetColor: Color3,\n\tDelay: number, -- Staggered takeoff delay\n}\n\n-- 1. Grid Formation (Matrix on ground or hovering plane)\nfunction FormationGenerator.createGrid(\n\tdroneCount: number,\n\tcenter: Vector3,\n\tspacing: number?,\n\taltitude: number?,\n\tcolor: Color3?\n): { DroneTarget }\n\tlocal dist = spacing or 4.0\n\tlocal alt = altitude or DroneConfig.FLIGHT.TAKEOFF_ALTITUDE\n\tlocal baseColor = color or DroneConfig.DRONE_MODEL.LED_DEFAULT_COLOR\n\n\tlocal cols = math.ceil(math.sqrt(droneCount))\n\tlocal rows = math.ceil(droneCount / cols)\n\tlocal targets: { DroneTarget } = {}\n\n\tlocal startX = center.X - ((cols - 1) * dist) / 2\n\tlocal startZ = center.Z - ((rows - 1) * dist) / 2\n\n\tfor i = 1, droneCount do\n\t\tlocal col = (i - 1) % cols\n\t\tlocal row = math.floor((i - 1) / cols)\n\n\t\tlocal pos = Vector3.new(startX + col * dist, center.Y + alt, startZ + row * dist)\n\t\ttable.insert(targets, {\n\t\t\tDroneId = i,\n\t\t\tTargetPosition = pos,\n\t\t\tTargetColor = baseColor,\n\t\t\tDelay = (col + row) * 0.05, -- Wave takeoff\n\t\t})\n\tend\n\n\treturn targets\nend\n\n-- 2. Concentric Rings / Circle Formation\nfunction FormationGenerator.createCircle(\n\tdroneCount: number,\n\tcenter: Vector3,\n\tradius: number?,\n\taltitude: number?,\n\tcolor: Color3?\n): { DroneTarget }\n\tlocal r = radius or (droneCount * 0.8)\n\tlocal alt = altitude or DroneConfig.FLIGHT.TAKEOFF_ALTITUDE\n\tlocal baseColor = color or Color3.fromRGB(0, 200, 255)\n\tlocal targets: { DroneTarget } = {}\n\n\tfor i = 1, droneCount do\n\t\tlocal angle = ((i - 1) / droneCount) * (2 * math.pi)\n\t\tlocal x = center.X + math.cos(angle) * r\n\t\tlocal z = center.Z + math.sin(angle) * r\n\n\t\ttable.insert(targets, {\n\t\t\tDroneId = i,\n\t\t\tTargetPosition = Vector3.new(x, center.Y + alt, z),\n\t\t\tTargetColor = baseColor,\n\t\t\tDelay = (i / droneCount) * 1.5,\n\t\t})\n\tend\n\n\treturn targets\nend\n\n-- 3. 3D Heart Formation (Show Classic)\nfunction FormationGenerator.createHeart(\n\tdroneCount: number,\n\tcenter: Vector3,\n\tscale: number?,\n\taltitude: number?,\n\tcolor: Color3?\n): { DroneTarget }\n\tlocal s = scale or 1.5\n\tlocal alt = altitude or (DroneConfig.FLIGHT.TAKEOFF_ALTITUDE + 20)\n\tlocal redColor = color or Color3.fromRGB(255, 30, 80)\n\tlocal targets: { DroneTarget } = {}\n\n\tfor i = 1, droneCount do\n\t\tlocal t = ((i - 1) / droneCount) * (2 * math.pi)\n\t\t-- Parametric heart curve equation:\n\t\t-- x = 16 * sin^3(t)\n\t\t-- y = 13 * cos(t) - 5 * cos(2t) - 2 * cos(3t) - cos(4t)\n\t\tlocal hx = 16 * (math.sin(t) ^ 3)\n\t\tlocal hy = 13 * math.cos(t) - 5 * math.cos(2 * t) - 2 * math.cos(3 * t) - math.cos(4 * t)\n\n\t\tlocal pos = Vector3.new(center.X + hx * s, center.Y + alt + hy * s, center.Z)\n\t\ttable.insert(targets, {\n\t\t\tDroneId = i,\n\t\t\tTargetPosition = pos,\n\t\t\tTargetColor = redColor,\n\t\t\tDelay = math.abs(math.sin(t)) * 1.0,\n\t\t})\n\tend\n\n\treturn targets\nend\n\n-- 4. 3D Sphere / Globe Formation (Fibonacci Lattice Distribution)\nfunction FormationGenerator.createSphere(\n\tdroneCount: number,\n\tcenter: Vector3,\n\tradius: number?,\n\taltitude: number?\n): { DroneTarget }\n\tlocal r = radius or 25.0\n\tlocal alt = altitude or (DroneConfig.FLIGHT.TAKEOFF_ALTITUDE + 35)\n\tlocal targets: { DroneTarget } = {}\n\tlocal phi = math.pi * (3 - math.sqrt(5)) -- Golden angle\n\n\tfor i = 1, droneCount do\n\t\tlocal y = 1 - ((i - 1) / (droneCount - 1)) * 2 -- y goes from 1 to -1\n\t\tlocal radiusAtY = math.sqrt(1 - y * y)\n\t\tlocal theta = phi * (i - 1)\n\n\t\tlocal x = math.cos(theta) * radiusAtY\n\t\tlocal z = math.sin(theta) * radiusAtY\n\n\t\tlocal worldPos = Vector3.new(center.X + x * r, center.Y + alt + y * r, center.Z + z * r)\n\t\t-- Rainbow gradient by latitude:\n\t\tlocal hue = (y + 1) / 2\n\t\tlocal col = Color3.fromHSV(hue, 0.85, 1.0)\n\n\t\ttable.insert(targets, {\n\t\t\tDroneId = i,\n\t\t\tTargetPosition = worldPos,\n\t\t\tTargetColor = col,\n\t\t\tDelay = (i / droneCount) * 2.0,\n\t\t})\n\tend\n\n\treturn targets\nend\n\n-- 5. Double Helix (DNA Spiral) Formation\nfunction FormationGenerator.createHelix(\n\tdroneCount: number,\n\tcenter: Vector3,\n\theight: number?,\n\tradius: number?\n): { DroneTarget }\n\tlocal h = height or 60.0\n\tlocal r = radius or 12.0\n\tlocal targets: { DroneTarget } = {}\n\tlocal strandCount = math.floor(droneCount / 2)\n\n\tfor strand = 1, 2 do\n\t\tlocal strandOffset = (strand - 1) * math.pi\n\t\tlocal strandColor = if strand == 1 then Color3.fromRGB(0, 255, 255) else Color3.fromRGB(255, 0, 200)\n\n\t\tfor i = 1, strandCount do\n\t\t\tlocal id = (strand - 1) * strandCount + i\n\t\t\tlocal prog = (i - 1) / (strandCount - 1)\n\t\t\tlocal angle = prog * (4 * math.pi) + strandOffset\n\t\t\tlocal y = center.Y + DroneConfig.FLIGHT.TAKEOFF_ALTITUDE + prog * h\n\t\t\tlocal x = center.X + math.cos(angle) * r\n\t\t\tlocal z = center.Z + math.sin(angle) * r\n\n\t\t\ttable.insert(targets, {\n\t\t\t\tDroneId = id,\n\t\t\t\tTargetPosition = Vector3.new(x, y, z),\n\t\t\t\tTargetColor = strandColor,\n\t\t\t\tDelay = prog * 2.0,\n\t\t\t})\n\t\tend\n\tend\n\n\treturn targets\nend\n\nreturn table.freeze(FormationGenerator)\n"
    s.Parent = parent
    print("[DroneInstaller] Installed FormationGenerator (ModuleScript)")
end

do
    local parent = game:GetService("ReplicatedStorage")
    local existing = parent:FindFirstChild("DataExporter")
    if existing then existing:Destroy() end
    local s = Instance.new("ModuleScript")
    s.Name = "DataExporter"
    s.Source = "--!strict\n-- DataExporter.luau\n-- Serializes simulation trajectories to JSON / CSV formats for physical drone firmware loading.\n\nlocal HttpService = game:GetService(\"HttpService\")\nlocal DroneConfig = require(script.Parent.DroneConfig)\nlocal FlightMath = require(script.Parent.FlightMath)\n\nlocal DataExporter = {}\n\nexport type DroneTrajectoryPoint = {\n\tt: number,       -- Time offset in seconds\n\tx: number,       -- East coordinate in meters\n\ty: number,       -- North coordinate in meters\n\tz: number,       -- Altitude in meters (Up)\n\tyaw: number,     -- Heading in degrees\n\tr: number,       -- LED Red (0-255)\n\tg: number,       -- LED Green (0-255)\n\tb: number,       -- LED Blue (0-255)\n}\n\nexport type DroneMissionPlan = {\n\tdrone_id: number,\n\texport_timestamp: number,\n\tsample_rate_hz: number,\n\ttotal_duration_sec: number,\n\tpoints: { DroneTrajectoryPoint },\n}\n\n-- Convert Waypoints list of Roblox coordinates to time-sampled physical metric mission\nfunction DataExporter.generateMissionFromPath(\n\tdroneId: number,\n\twaypoints: { FlightMath.Waypoint },\n\tsampleRateHz: number?,\n\toriginRef: Vector3?\n): DroneMissionPlan\n\tlocal hz = sampleRateHz or 10 -- 10Hz standard telemetry rate\n\tlocal dt = 1 / hz\n\tlocal positions: { Vector3 } = {}\n\n\tfor _, wp in ipairs(waypoints) do\n\t\ttable.insert(positions, wp.Position)\n\tend\n\n\tlocal segLengths, totalLen = FlightMath.calculatePathLengths(positions)\n\tlocal avgSpeed = DroneConfig.FLIGHT.MAX_HORIZONTAL_SPEED\n\tlocal totalDuration = if totalLen > 0 then (totalLen / avgSpeed) else 5.0\n\tlocal totalSamples = math.ceil(totalDuration * hz)\n\n\tlocal missionPoints: { DroneTrajectoryPoint } = {}\n\n\tfor s = 0, totalSamples do\n\t\tlocal t = s * dt\n\t\tlocal dist = (t / totalDuration) * totalLen\n\t\tlocal robloxPos, forwardVec = FlightMath.sampleSplineAtDistance(positions, segLengths, totalLen, dist)\n\n\t\t-- Convert to meters ENU (East, North, Up)\n\t\tlocal metricPos = FlightMath.studsToMetersENU(robloxPos, originRef)\n\n\t\t-- Compass heading (0 = North, 90 = East) from the forward vector\n\t\tlocal yawDeg = math.deg(math.atan2(forwardVec.X, -forwardVec.Z)) % 360\n\n\t\ttable.insert(missionPoints, {\n\t\t\tt = math.round(t * 100) / 100,\n\t\t\tx = math.round(metricPos.X * 100) / 100,\n\t\t\ty = math.round(metricPos.Y * 100) / 100,\n\t\t\tz = math.round(metricPos.Z * 100) / 100,\n\t\t\tyaw = math.round(yawDeg * 10) / 10,\n\t\t\tr = 0,\n\t\t\tg = 255,\n\t\t\tb = 120,\n\t\t})\n\tend\n\n\treturn {\n\t\tdrone_id = droneId,\n\t\texport_timestamp = os.time(),\n\t\tsample_rate_hz = hz,\n\t\ttotal_duration_sec = math.round(totalDuration * 100) / 100,\n\t\tpoints = missionPoints,\n\t}\nend\n\n-- Export single drone mission to JSON\nfunction DataExporter.exportToJSON(mission: DroneMissionPlan): string\n\treturn HttpService:JSONEncode(mission)\nend\n\n-- Export single drone mission to CSV (t, x_m, y_m, z_m, yaw_deg, r, g, b)\nfunction DataExporter.exportToCSV(mission: DroneMissionPlan): string\n\tlocal lines = {\n\t\t\"# Drone Light Show Trajectory Export\",\n\t\tstring.format(\"# Drone ID: %d | Total Duration: %.2fs | Rate: %d Hz\", mission.drone_id, mission.total_duration_sec, mission.sample_rate_hz),\n\t\t\"time_sec,x_east_m,y_north_m,z_up_m,yaw_deg,led_r,led_g,led_b\"\n\t}\n\n\tfor _, pt in ipairs(mission.points) do\n\t\ttable.insert(lines, string.format(\n\t\t\t\"%.2f,%.3f,%.3f,%.3f,%.1f,%d,%d,%d\",\n\t\t\tpt.t, pt.x, pt.y, pt.z, pt.yaw, pt.r, pt.g, pt.b\n\t\t))\n\tend\n\n\treturn table.concat(lines, \"\\n\")\nend\n\n-- Export entire swarm (all 800 drones) into one consolidated JSON dictionary\nfunction DataExporter.exportSwarmToJSON(swarmMissions: { [number]: DroneMissionPlan }): string\n\tlocal swarmPackage = {\n\t\tproject = \"Drone Light Show Simulation\",\n\t\tcreated_at = os.date(\"!%Y-%m-%dT%H:%M:%SZ\"),\n\t\tdrone_count = 0,\n\t\tdrones = swarmMissions,\n\t}\n\n\tfor _ in pairs(swarmMissions) do\n\t\tswarmPackage.drone_count += 1\n\tend\n\n\treturn HttpService:JSONEncode(swarmPackage)\nend\n\n-- Parse and Import mission from JSON\nfunction DataExporter.importFromJSON(jsonString: string): DroneMissionPlan?\n\tlocal success, result = pcall(function()\n\t\treturn HttpService:JSONDecode(jsonString)\n\tend)\n\n\tif success and type(result) == \"table\" and result.points then\n\t\treturn result :: DroneMissionPlan\n\tend\n\n\twarn(\"[DataExporter] Failed to parse JSON mission:\", result)\n\treturn nil\nend\n\nreturn table.freeze(DataExporter)\n"
    s.Parent = parent
    print("[DroneInstaller] Installed DataExporter (ModuleScript)")
end

do
    local parent = game:GetService("ReplicatedStorage")
    local existing = parent:FindFirstChild("FlightPackage")
    if existing then existing:Destroy() end
    local s = Instance.new("ModuleScript")
    s.Name = "FlightPackage"
    s.Source = "--!strict\n-- FlightPackage.luau\n-- Encodes simulator flights as \"drone-sim-flight\" JSON: meters East/North/Up relative to the\n-- launch pad (DroneConfig.HOME). tools/sim2mission.py turns this into a Pixhawk mission\n-- (.plan / .waypoints) anchored at the real drone's GPS home.\n\nlocal DroneConfig = require(script.Parent.DroneConfig)\nlocal FlightMath = require(script.Parent.FlightMath)\n\nlocal FlightPackage = {}\n\nexport type RecordedSample = {\n\tt: number,        -- seconds since recording start\n\tPosition: Vector3, -- Roblox studs\n\tYaw: number,       -- simulator yaw in degrees (pilot controller convention)\n\tPitch: number,\n\tRoll: number,\n}\n\nlocal function toENU(pos: Vector3): Vector3\n\treturn FlightMath.studsToMetersENU(pos, DroneConfig.HOME.SIM_POSITION)\nend\n\n-- Pilot controller yaw turns counter-clockwise from North; compass heading turns clockwise.\nfunction FlightPackage.headingFromSimYaw(simYawDeg: number): number\n\treturn (-simYawDeg) % 360\nend\n\n-- Compass heading (0 = North, 90 = East) of a Roblox direction vector (-Z is North).\nfunction FlightPackage.headingFromVector(dir: Vector3): number\n\treturn math.deg(math.atan2(dir.X, -dir.Z)) % 360\nend\n\nlocal function header(source: string, extra: string): string\n\t-- Real-world sites know the launch pad's GPS, so the converter can place the mission there.\n\tlocal geo = DroneConfig.HOME.GEO\n\tlocal homeGeo = if geo then string.format('\"home_geo\":[%.7f,%.7f,%.1f],', geo[1], geo[2], geo[3] or 0) else \"\"\n\treturn string.format(\n\t\t'{\"format\":\"drone-sim-flight\",\"version\":1,\"source\":\"%s\",\"frame\":\"ENU_m_relative_to_home\",'\n\t\t\t.. '\"site\":\"%s\",%s\"stud_per_meter\":%s,\"created_at\":\"%s\",%s',\n\t\tsource,\n\t\tDroneConfig.ACTIVE_SITE,\n\t\thomeGeo,\n\t\ttostring(DroneConfig.STUDS_PER_METER),\n\t\tDateTime.now():ToIsoDate(),\n\t\textra\n\t)\nend\n\n-- Manual flight recording. Built by hand (not JSONEncode) to keep 10 Hz recordings compact\n-- enough for the copy modal.\nfunction FlightPackage.encodeRecording(samples: { RecordedSample }, sampleRateHz: number): string\n\tlocal rows = table.create(#samples)\n\tfor i, s in ipairs(samples) do\n\t\tlocal enu = toENU(s.Position)\n\t\trows[i] = string.format(\n\t\t\t\"[%.2f,%.2f,%.2f,%.2f,%.0f]\",\n\t\t\ts.t,\n\t\t\tenu.X,\n\t\t\tenu.Y,\n\t\t\tenu.Z,\n\t\t\tFlightPackage.headingFromSimYaw(s.Yaw)\n\t\t)\n\tend\n\treturn header(\n\t\t\"manual_recording\",\n\t\tstring.format('\"sample_rate_hz\":%d,\"columns\":[\"t\",\"e\",\"n\",\"u\",\"hdg\"],\"samples\":[', sampleRateHz)\n\t) .. table.concat(rows, \",\") .. \"]}\"\nend\n\n-- Waypoint route drawn in the editor. Real drones fly straight legs between waypoints, so the\n-- waypoints themselves are exported, not the spline the simulator draws through them.\nfunction FlightPackage.encodeRoute(waypoints: { FlightMath.Waypoint }): string\n\tlocal rows = table.create(#waypoints)\n\tfor i, wp in ipairs(waypoints) do\n\t\tlocal enu = toENU(wp.Position)\n\t\tlocal speed = if wp.Speed then string.format(',\"speed\":%.2f', wp.Speed / DroneConfig.STUDS_PER_METER) else \"\"\n\t\trows[i] = string.format('{\"e\":%.2f,\"n\":%.2f,\"u\":%.2f%s}', enu.X, enu.Y, enu.Z, speed)\n\tend\n\treturn header(\"waypoint_route\", '\"waypoints\":[') .. table.concat(rows, \",\") .. \"]}\"\nend\n\nreturn table.freeze(FlightPackage)\n"
    s.Parent = parent
    print("[DroneInstaller] Installed FlightPackage (ModuleScript)")
end

do
    local parent = game:GetService("ReplicatedStorage")
    local existing = parent:FindFirstChild("DroneHealthModel")
    if existing then existing:Destroy() end
    local s = Instance.new("ModuleScript")
    s.Name = "DroneHealthModel"
    s.Source = "--!strict\n-- DroneHealthModel.luau\n-- Quad-X motor mixer, motor (RPM / current / temperature) and LiPo battery model.\n-- The telemetry fields mirror what a Pixhawk reports over MAVLink (SERVO_OUTPUT_RAW,\n-- ESC_TELEMETRY_1_TO_4, BATTERY_STATUS) so the same health panel can later show the real drone.\n\nlocal DroneConfig = require(script.Parent.DroneConfig)\n\nlocal AF = DroneConfig.AIRFRAME\nlocal GRAVITY = 9.81\n\nlocal DroneHealthModel = {}\n\n-- ArduPilot Quad-X: angle from the nose (deg, clockwise) and propeller spin direction.\n-- roll factor = cos(angle + 90), pitch factor = cos(angle), yaw: CCW = +1, CW = -1.\nDroneHealthModel.MOTORS = table.freeze({\n\t{ Name = \"M1 \u00d6N-SA\u011e\", Angle = 45, Yaw = 1 },\n\t{ Name = \"M2 ARKA-SOL\", Angle = -135, Yaw = 1 },\n\t{ Name = \"M3 \u00d6N-SOL\", Angle = -45, Yaw = -1 },\n\t{ Name = \"M4 ARKA-SA\u011e\", Angle = 135, Yaw = -1 },\n})\n\nexport type MotorState = {\n\tOutput: number,   -- 0..1 command (SERVO_OUTPUT_RAW)\n\tRpm: number,      -- ESC telemetry\n\tCurrentA: number,\n\tTempC: number,\n\tFailed: boolean,\n\tSaturated: boolean,\n\tEfficiency: number, -- thrust per unit output, 1 = healthy (damaged prop / weak motor < 1)\n}\n\nexport type Telemetry = {\n\tMotors: { MotorState },\n\tArmed: boolean,\n\tVoltageV: number,\n\tCellV: number,\n\tCurrentA: number,\n\tUsedMah: number,\n\tRemainingPct: number,\n\tThrustToWeight: number, -- instantaneous total thrust / weight (1.0 = hover)\n}\n\nfunction DroneHealthModel.new(): Telemetry\n\tlocal motors = {}\n\tfor i = 1, #DroneHealthModel.MOTORS do\n\t\tmotors[i] = { Output = 0, Rpm = 0, CurrentA = 0, TempC = AF.AMBIENT_TEMP_C, Failed = false, Saturated = false, Efficiency = 1 }\n\tend\n\treturn {\n\t\tMotors = motors,\n\t\tArmed = false,\n\t\tVoltageV = AF.BATTERY_CELLS * 4.2,\n\t\tCellV = 4.2,\n\t\tCurrentA = 0,\n\t\tUsedMah = 0,\n\t\tRemainingPct = 100,\n\t\tThrustToWeight = 0,\n\t}\nend\n\n-- Resting LiPo cell voltage by state of charge (0..1)\nlocal OCV_CURVE = { { 0, 3.30 }, { 0.10, 3.60 }, { 0.25, 3.72 }, { 0.50, 3.82 }, { 0.75, 3.97 }, { 0.90, 4.10 }, { 1, 4.20 } }\n\nlocal function cellOpenCircuit(soc: number): number\n\tsoc = math.clamp(soc, 0, 1)\n\tfor i = 2, #OCV_CURVE do\n\t\tlocal a, b = OCV_CURVE[i - 1], OCV_CURVE[i]\n\t\tif soc <= b[1] then\n\t\t\treturn a[2] + (b[2] - a[2]) * (soc - a[1]) / (b[1] - a[1])\n\t\tend\n\tend\n\treturn 4.2\nend\n\n-- accelMs2: world acceleration of the drone (m/s\u00b2, Y up).\n-- angAccel: body angular acceleration (rad/s\u00b2) around roll, pitch, yaw axes.\nfunction DroneHealthModel.step(t: Telemetry, dt: number, accelMs2: Vector3, angAccel: Vector3, armed: boolean)\n\tt.Armed = armed\n\n\t-- Total thrust must cancel gravity and produce the acceleration (thrust acts along body-up).\n\tlocal totalThrust = if armed then AF.MASS_KG * (accelMs2 + Vector3.new(0, GRAVITY, 0)).Magnitude else 0\n\tt.ThrustToWeight = totalThrust / (AF.MASS_KG * GRAVITY)\n\n\t-- Differential thrust (N per unit mixer factor) needed for the angular accelerations\n\tlocal lever = AF.ARM_LENGTH_M * 0.707 * 4\n\tlocal rollN = angAccel.X * AF.INERTIA_KGM2 / lever\n\tlocal pitchN = angAccel.Y * AF.INERTIA_KGM2 / lever\n\tlocal yawN = angAccel.Z * AF.INERTIA_KGM2 / (lever * 0.25) -- yaw comes from weak prop drag torque\n\n\tlocal working = 0\n\tfor _, m in ipairs(t.Motors) do\n\t\tif not m.Failed then\n\t\t\tworking += 1\n\t\tend\n\tend\n\tlocal base = if working > 0 then totalThrust / working else 0\n\n\tlocal totalCurrent = AF.AVIONICS_CURRENT_A\n\tfor i, m in ipairs(t.Motors) do\n\t\tlocal geom = DroneHealthModel.MOTORS[i]\n\t\tlocal rad = math.rad(geom.Angle)\n\t\tlocal thrust = base + rollN * math.cos(rad + math.pi / 2) + pitchN * math.cos(rad) + yawN * geom.Yaw\n\t\t-- A weak motor must be driven harder for the same thrust (the attitude controller does exactly that)\n\t\tlocal out = if armed and not m.Failed then thrust / (AF.MAX_THRUST_PER_MOTOR_N * m.Efficiency) else 0\n\t\tm.Saturated = out >= 1\n\t\tout = if armed and not m.Failed then math.clamp(out, AF.MOT_SPIN_ARM, 1) else 0\n\t\tm.Output = out\n\t\tm.Rpm = AF.MAX_MOTOR_RPM * math.sqrt(out) -- thrust grows with RPM\u00b2\n\t\tm.CurrentA = AF.MAX_MOTOR_CURRENT_A * out ^ 1.5\n\t\ttotalCurrent += m.CurrentA\n\n\t\t-- First-order motor heating toward a load-dependent temperature\n\t\tlocal targetTemp = AF.AMBIENT_TEMP_C + 70 * out * out\n\t\tm.TempC += (targetTemp - m.TempC) * math.min(1, dt / 40)\n\tend\n\n\tt.CurrentA = totalCurrent\n\tt.UsedMah += totalCurrent * dt / 3.6\n\tlocal soc = 1 - t.UsedMah / AF.BATTERY_CAPACITY_MAH\n\tt.RemainingPct = math.max(0, soc * 100)\n\tt.VoltageV = AF.BATTERY_CELLS * cellOpenCircuit(soc) - totalCurrent * AF.BATTERY_RESISTANCE_OHM\n\tt.CellV = t.VoltageV / AF.BATTERY_CELLS\nend\n\nreturn DroneHealthModel\n"
    s.Parent = parent
    print("[DroneInstaller] Installed DroneHealthModel (ModuleScript)")
end

do
    local parent = game:GetService("ReplicatedStorage")
    local existing = parent:FindFirstChild("WindModel")
    if existing then existing:Destroy() end
    local s = Instance.new("ModuleScript")
    s.Name = "WindModel"
    s.Source = "--!strict\n-- WindModel.luau\n-- Turns the 10 m wind report published by WeatherService (ReplicatedStorage.Weather attributes)\n-- into the wind vector the drone feels at its altitude: log wind profile over the city plus\n-- turbulence (gusts) from coherent noise. Returns meters/second, Roblox axes (X east, Z south).\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal DroneConfig = require(script.Parent.DroneConfig)\n\nlocal W = DroneConfig.WEATHER\n\nlocal WindModel = {}\n\nexport type Report = {\n\tSpeedMs: number, -- mean 10 m wind\n\tFromDeg: number, -- meteorological direction the wind blows FROM; < 0 = variable\n\tGustMs: number, -- 0 when not reported\n\tSource: string,\n}\n\nlocal function weatherFolder(): Instance?\n\treturn ReplicatedStorage:FindFirstChild(\"Weather\")\nend\n\nfunction WindModel.report(): Report\n\tlocal f = weatherFolder()\n\tif not f then\n\t\treturn { SpeedMs = W.MANUAL.SPEED_MS, FromDeg = W.MANUAL.FROM_DEG, GustMs = W.MANUAL.GUST_MS, Source = \"MANUEL\" }\n\tend\n\treturn {\n\t\tSpeedMs = (f:GetAttribute(\"SpeedMs\") :: number?) or 0,\n\t\tFromDeg = (f:GetAttribute(\"FromDeg\") :: number?) or 0,\n\t\tGustMs = (f:GetAttribute(\"GustMs\") :: number?) or 0,\n\t\tSource = (f:GetAttribute(\"Source\") :: string?) or \"?\",\n\t}\nend\n\n-- Mean wind speed at `heightM` above ground over the city, from a 10 m report over open terrain.\nfunction WindModel.profileFactor(heightM: number): number\n\tlocal h = math.max(heightM, 2 * W.SITE_Z0_M)\n\tlocal toBlend = math.log(W.BLEND_HEIGHT_M / W.SOURCE_Z0_M) / math.log(10 / W.SOURCE_Z0_M)\n\tlocal fromBlend = math.log(h / W.SITE_Z0_M) / math.log(W.BLEND_HEIGHT_M / W.SITE_Z0_M)\n\treturn toBlend * math.min(fromBlend, 1.2)\nend\n\n-- Unit vector the air moves toward, for a meteorological \"from\" direction (0 = from north).\nlocal function towardVector(fromDeg: number): Vector3\n\tlocal toward = math.rad(fromDeg + 180)\n\treturn Vector3.new(math.sin(toward), 0, -math.cos(toward)) -- east = sin, north = cos (-Z)\nend\n\n-- Smooth pseudo-random signal with roughly unit standard deviation (two octaves of Perlin noise).\nlocal function turbulence(t: number, seed: number): number\n\treturn (math.noise(t, seed, 0.5) * 2.2 + math.noise(t * 2.7, seed + 17.3, 0.5) * 1.1)\nend\n\n-- Wind the drone feels at time `t` (s) and height above ground `aglM`.\nfunction WindModel.at(t: number, aglM: number, report: Report?): Vector3\n\tlocal r = report or WindModel.report()\n\tlocal mean = r.SpeedMs * WindModel.profileFactor(aglM)\n\tif mean < 0.05 and r.GustMs <= 0 then\n\t\treturn Vector3.zero\n\tend\n\n\t-- Variable direction (METAR \"VRB\"): wander slowly around the compass\n\tlocal fromDeg = if r.FromDeg >= 0 then r.FromDeg else (math.noise(t / 60, 3.1) * 360 + 180)\n\tlocal along = towardVector(fromDeg)\n\tlocal across = Vector3.new(-along.Z, 0, along.X)\n\n\t-- Gust report -> turbulence sigma (peak gust ~ mean + 2.5 sigma); otherwise a city default\n\tlocal sigma = if r.GustMs > r.SpeedMs then (r.GustMs - r.SpeedMs) / 2.5 else W.TURBULENCE_INTENSITY * r.SpeedMs\n\tsigma *= WindModel.profileFactor(aglM)\n\tlocal timescale = math.clamp(W.EDDY_LENGTH_M / math.max(mean, 1), 1, 10)\n\tlocal tt = t / timescale\n\n\treturn along * (mean + sigma * turbulence(tt, 1.7))\n\t\t+ across * (0.75 * sigma * turbulence(tt, 9.2))\n\t\t+ Vector3.new(0, 0.5 * sigma * turbulence(tt, 23.5), 0)\nend\n\nreturn WindModel\n"
    s.Parent = parent
    print("[DroneInstaller] Installed WindModel (ModuleScript)")
end


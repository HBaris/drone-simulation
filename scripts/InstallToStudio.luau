    local s = Instance.new("ModuleScript")
    s.Name = "DroneConfig"
    s.Source = "--!strict\n-- DroneConfig.luau\n-- Global configuration parameters for Drone Flight & Swarm Show Simulation\n\nlocal DroneConfig = {\n\t-- World & Physics Scale\n\t-- In Roblox, standard scale: 1 stud \u2248 0.28 meters (or 1 stud = 0.5m in custom flight models).\n\t-- Here we define conversion factor for real-world drone translation:\n\tSTUDS_PER_METER = 3.5, -- ~0.285m per stud\n\n\t-- Physical Drone Properties\n\tDRONE_MODEL = {\n\t\tFRAME_SIZE = Vector3.new(2.4, 0.5, 2.4), -- Studs (X, Y, Z)\n\t\tBODY_COLOR = Color3.fromRGB(30, 30, 35),\n\t\tROTOR_RADIUS = 0.7,\n\t\tROTOR_RPM = 4800,\n\t\tLED_DEFAULT_COLOR = Color3.fromRGB(0, 255, 120), -- Neon Green\n\t\tLED_BRIGHTNESS = 2.0,\n\t\tCOLLISION_RADIUS = 2.0, -- Minimum distance between drones (studs)\n\t},\n\n\t-- Flight Kinematics & Limits (Real drone physical limits)\n\tFLIGHT = {\n\t\tMAX_HORIZONTAL_SPEED = 20.0, -- studs/sec (~6 m/s)\n\t\tMAX_CLIMB_SPEED = 12.0,      -- studs/sec (~3.5 m/s)\n\t\tMAX_DESCENT_SPEED = 8.0,     -- studs/sec (~2.3 m/s)\n\t\tMAX_ACCELERATION = 15.0,     -- studs/sec^2\n\t\tMAX_TILT_ANGLE = 30.0,       -- degrees (pitch/roll when moving fast)\n\t\tMAX_YAW_RATE = 120.0,        -- degrees/sec\n\t\tTAKEOFF_ALTITUDE = 15.0,     -- Default hover altitude above ground\n\t\tRETURN_TO_HOME_ALT = 25.0,   -- Safe transit altitude\n\t},\n\n\t-- Swarm Performance (Supports up to 800+ drones)\n\tSWARM = {\n\t\tMAX_DRONES = 800,\n\t\tBATCH_UPDATE_SIZE = 100,     -- Chunk size for BulkMoveTo\n\t\tUSE_CLIENT_INTERPOLATION = true,\n\t\tSYNC_RATE_HZ = 30,           -- Network replication frequency (Server -> Client)\n\t\tSIMULATION_STEP_DT = 1 / 60, -- 60 FPS physics tick\n\t},\n\n\t-- Visual & LED Show Settings\n\tLIGHT_SHOW = {\n\t\tENABLE_TRAILS = true,\n\t\tTRAIL_LIFETIME = 0.8,\n\t\tCOLOR_PALETTES = {\n\t\t\tCYAN_PINK = { Color3.fromRGB(0, 255, 255), Color3.fromRGB(255, 0, 128) },\n\t\t\tGOLD_WHITE = { Color3.fromRGB(255, 215, 0), Color3.fromRGB(255, 255, 255) },\n\t\t\tRAINBOW = {\n\t\t\t\tColor3.fromRGB(255, 0, 0),\n\t\t\t\tColor3.fromRGB(255, 127, 0),\n\t\t\t\tColor3.fromRGB(255, 255, 0),\n\t\t\t\tColor3.fromRGB(0, 255, 0),\n\t\t\t\tColor3.fromRGB(0, 0, 255),\n\t\t\t\tColor3.fromRGB(75, 0, 130),\n\t\t\t\tColor3.fromRGB(148, 0, 211),\n\t\t\t},\n\t\t\tTURKISH_FLAG = { Color3.fromRGB(230, 0, 0), Color3.fromRGB(255, 255, 255) },\n\t\t},\n\t},\n\n\t-- Export Formats\n\tEXPORT = {\n\t\tVERSION = \"1.0\",\n\t\tDEFAULT_FORMAT = \"JSON\", -- Options: \"JSON\", \"CSV\", \"MAVLINK_MISSION\"\n\t}\n}\n\nreturn table.freeze(DroneConfig)\n"
    s.Parent = parent
    print("[DroneInstaller] Installed DroneConfig (ModuleScript)")
end

do
    local parent = game:GetService("ReplicatedStorage")
    local existing = parent:FindFirstChild("FlightMath")
    if existing then existing:Destroy() end
    local s = Instance.new("ModuleScript")
    s.Name = "FlightMath"
    s.Source = "--!strict\n-- FlightMath.luau\n-- Mathematical utilities for Drone trajectory calculation, Splines, Bank angles, and Geo-coordinates.\n\nlocal DroneConfig = require(script.Parent.DroneConfig)\n\nlocal FlightMath = {}\n\n-- Catmull-Rom Spline Interpolation between 4 points\n-- Passes directly through P1 (at t=0) and P2 (at t=1)\nfunction FlightMath.catmullRom(p0: Vector3, p1: Vector3, p2: Vector3, p3: Vector3, t: number): Vector3\n\tlocal t2 = t * t\n\tlocal t3 = t2 * t\n\n\treturn 0.5 * (\n\t\t(2 * p1) +\n\t\t(-p0 + p2) * t +\n\t\t(2 * p0 - 5 * p1 + 4 * p2 - p3) * t2 +\n\t\t(-p0 + 3 * p1 - 3 * p2 + p3) * t3\n\t)\nend\n\n-- Evaluates full path across multiple waypoints at normalized parameter 0 <= u <= 1\nexport type Waypoint = {\n\tPosition: Vector3,\n\tAltitude: number, -- target height\n\tYaw: number?,     -- target yaw in degrees (optional)\n\tWaitTime: number?,-- wait time in seconds (optional)\n\tSpeed: number?,   -- segment target speed (optional)\n\tLedColor: Color3?,-- color for show (optional)\n}\n\n-- Computes total path length by sampling segments\nfunction FlightMath.calculatePathLengths(points: { Vector3 }, samplesPerSegment: number?): ({ number }, number)\n\tlocal samples = samplesPerSegment or 10\n\tlocal segmentLengths: { number } = {}\n\tlocal totalLength = 0\n\n\tif #points < 2 then\n\t\treturn segmentLengths, 0\n\tend\n\n\tfor i = 1, #points - 1 do\n\t\tlocal p0 = points[math.max(1, i - 1)]\n\t\tlocal p1 = points[i]\n\t\tlocal p2 = points[i + 1]\n\t\tlocal p3 = points[math.min(#points, i + 2)]\n\n\t\tlocal segLen = 0\n\t\tlocal prevPos = p1\n\t\tfor s = 1, samples do\n\t\t\tlocal t = s / samples\n\t\t\tlocal pos = FlightMath.catmullRom(p0, p1, p2, p3, t)\n\t\t\tsegLen += (pos - prevPos).Magnitude\n\t\t\tprevPos = pos\n\t\tend\n\t\ttable.insert(segmentLengths, segLen)\n\t\ttotalLength += segLen\n\tend\n\n\treturn segmentLengths, totalLength\nend\n\n-- Sample position and forward direction at arc-length distance `dist` along waypoints\nfunction FlightMath.sampleSplineAtDistance(\n\tpoints: { Vector3 },\n\tsegmentLengths: { number },\n\ttotalLength: number,\n\tdistance: number\n): (Vector3, Vector3)\n\tif #points == 0 then\n\t\treturn Vector3.zero, Vector3.new(0, 0, -1)\n\telseif #points == 1 then\n\t\treturn points[1], Vector3.new(0, 0, -1)\n\tend\n\n\tlocal targetDist = math.clamp(distance, 0, totalLength)\n\tlocal accumulated = 0\n\tlocal targetSegment = 1\n\tlocal localT = 0\n\n\tfor i, len in ipairs(segmentLengths) do\n\t\tif accumulated + len >= targetDist or i == #segmentLengths then\n\t\t\ttargetSegment = i\n\t\t\tlocal rem = targetDist - accumulated\n\t\t\tlocalT = if len > 0 then math.clamp(rem / len, 0, 1) else 0\n\t\t\tbreak\n\t\tend\n\t\taccumulated += len\n\tend\n\n\tlocal p0 = points[math.max(1, targetSegment - 1)]\n\tlocal p1 = points[targetSegment]\n\tlocal p2 = points[targetSegment + 1]\n\tlocal p3 = points[math.min(#points, targetSegment + 2)]\n\n\tlocal pos = FlightMath.catmullRom(p0, p1, p2, p3, localT)\n\n\t-- Compute tangent vector (forward look direction)\n\tlocal deltaT = 0.01\n\tlocal nextPos = FlightMath.catmullRom(p0, p1, p2, p3, math.min(1, localT + deltaT))\n\tlocal forward = (nextPos - pos)\n\tif forward.Magnitude > 0.001 then\n\t\tforward = forward.Unit\n\telse\n\t\tforward = Vector3.new(0, 0, -1)\n\tend\n\n\treturn pos, forward\nend\n\n-- Calculates realistic quadcopter pitch and roll tilt based on velocity/acceleration\nfunction FlightMath.computeDroneTilt(\n\tvelocity: Vector3,\n\tacceleration: Vector3,\n\tbaseCFrame: CFrame\n): CFrame\n\tlocal maxTiltRad = math.rad(DroneConfig.FLIGHT.MAX_TILT_ANGLE)\n\n\t-- Transform acceleration into drone local coordinates\n\tlocal localAcc = baseCFrame:VectorToObjectSpace(acceleration)\n\n\t-- Pitch leans forward when accelerating forward (along -Z), leans back when braking\n\tlocal pitch = math.clamp(-localAcc.Z * 0.05, -maxTiltRad, maxTiltRad)\n\t-- Roll leans sideways when accelerating laterally (along +X)\n\tlocal roll = math.clamp(-localAcc.X * 0.05, -maxTiltRad, maxTiltRad)\n\n\treturn CFrame.Angles(pitch, 0, roll)\nend\n\n-- Convert Roblox Vector3 (Studs, Y-up) to Real-World Drone Metric Coordinates (Meters, Z-up ENU)\nfunction FlightMath.studsToMetersENU(pos: Vector3, origin: Vector3?): Vector3\n\tlocal ref = origin or Vector3.zero\n\tlocal rel = pos - ref\n\tlocal scale = 1 / DroneConfig.STUDS_PER_METER\n\n\t-- Roblox: X=East, Y=Altitude/Up, Z=South (-Z=North)\n\tlocal east = rel.X * scale\n\tlocal north = -rel.Z * scale\n\tlocal up = rel.Y * scale\n\n\treturn Vector3.new(east, north, up)\nend\n\n-- Convert Real-World Metric (Meters ENU) to Roblox Vector3 (Studs, Y-up)\nfunction FlightMath.metersENUToStuds(enu: Vector3, origin: Vector3?): Vector3\n\tlocal ref = origin or Vector3.zero\n\tlocal scale = DroneConfig.STUDS_PER_METER\n\n\tlocal x = enu.X * scale\n\tlocal y = enu.Z * scale\n\tlocal z = -enu.Y * scale\n\n\treturn ref + Vector3.new(x, y, z)\nend\n\nreturn table.freeze(FlightMath)\n"
    s.Parent = parent
    print("[DroneInstaller] Installed FlightMath (ModuleScript)")
end

do
    local parent = game:GetService("ReplicatedStorage")
    local existing = parent:FindFirstChild("FormationGenerator")
    if existing then existing:Destroy() end
    local s = Instance.new("ModuleScript")
    s.Name = "FormationGenerator"
    s.Source = "--!strict\n-- FormationGenerator.luau\n-- Pre-calculated 3D Swarm Formations for up to 800+ Light Show Drones\n\nlocal DroneConfig = require(script.Parent.DroneConfig)\n\nlocal FormationGenerator = {}\n\nexport type DroneTarget = {\n\tDroneId: number,\n\tTargetPosition: Vector3,\n\tTargetColor: Color3,\n\tDelay: number, -- Staggered takeoff delay\n}\n\n-- 1. Grid Formation (Matrix on ground or hovering plane)\nfunction FormationGenerator.createGrid(\n\tdroneCount: number,\n\tcenter: Vector3,\n\tspacing: number?,\n\taltitude: number?,\n\tcolor: Color3?\n): { DroneTarget }\n\tlocal dist = spacing or 4.0\n\tlocal alt = altitude or DroneConfig.FLIGHT.TAKEOFF_ALTITUDE\n\tlocal baseColor = color or DroneConfig.DRONE_MODEL.LED_DEFAULT_COLOR\n\n\tlocal cols = math.ceil(math.sqrt(droneCount))\n\tlocal rows = math.ceil(droneCount / cols)\n\tlocal targets: { DroneTarget } = {}\n\n\tlocal startX = center.X - ((cols - 1) * dist) / 2\n\tlocal startZ = center.Z - ((rows - 1) * dist) / 2\n\n\tfor i = 1, droneCount do\n\t\tlocal col = (i - 1) % cols\n\t\tlocal row = math.floor((i - 1) / cols)\n\n\t\tlocal pos = Vector3.new(startX + col * dist, center.Y + alt, startZ + row * dist)\n\t\ttable.insert(targets, {\n\t\t\tDroneId = i,\n\t\t\tTargetPosition = pos,\n\t\t\tTargetColor = baseColor,\n\t\t\tDelay = (col + row) * 0.05, -- Wave takeoff\n\t\t})\n\tend\n\n\treturn targets\nend\n\n-- 2. Concentric Rings / Circle Formation\nfunction FormationGenerator.createCircle(\n\tdroneCount: number,\n\tcenter: Vector3,\n\tradius: number?,\n\taltitude: number?,\n\tcolor: Color3?\n): { DroneTarget }\n\tlocal r = radius or (droneCount * 0.8)\n\tlocal alt = altitude or DroneConfig.FLIGHT.TAKEOFF_ALTITUDE\n\tlocal baseColor = color or Color3.fromRGB(0, 200, 255)\n\tlocal targets: { DroneTarget } = {}\n\n\tfor i = 1, droneCount do\n\t\tlocal angle = ((i - 1) / droneCount) * (2 * math.pi)\n\t\tlocal x = center.X + math.cos(angle) * r\n\t\tlocal z = center.Z + math.sin(angle) * r\n\n\t\ttable.insert(targets, {\n\t\t\tDroneId = i,\n\t\t\tTargetPosition = Vector3.new(x, center.Y + alt, z),\n\t\t\tTargetColor = baseColor,\n\t\t\tDelay = (i / droneCount) * 1.5,\n\t\t})\n\tend\n\n\treturn targets\nend\n\n-- 3. 3D Heart Formation (Show Classic)\nfunction FormationGenerator.createHeart(\n\tdroneCount: number,\n\tcenter: Vector3,\n\tscale: number?,\n\taltitude: number?,\n\tcolor: Color3?\n): { DroneTarget }\n\tlocal s = scale or 1.5\n\tlocal alt = altitude or (DroneConfig.FLIGHT.TAKEOFF_ALTITUDE + 20)\n\tlocal redColor = color or Color3.fromRGB(255, 30, 80)\n\tlocal targets: { DroneTarget } = {}\n\n\tfor i = 1, droneCount do\n\t\tlocal t = ((i - 1) / droneCount) * (2 * math.pi)\n\t\t-- Parametric heart curve equation:\n\t\t-- x = 16 * sin^3(t)\n\t\t-- y = 13 * cos(t) - 5 * cos(2t) - 2 * cos(3t) - cos(4t)\n\t\tlocal hx = 16 * (math.sin(t) ^ 3)\n\t\tlocal hy = 13 * math.cos(t) - 5 * math.cos(2 * t) - 2 * math.cos(3 * t) - math.cos(4 * t)\n\n\t\tlocal pos = Vector3.new(center.X + hx * s, center.Y + alt + hy * s, center.Z)\n\t\ttable.insert(targets, {\n\t\t\tDroneId = i,\n\t\t\tTargetPosition = pos,\n\t\t\tTargetColor = redColor,\n\t\t\tDelay = math.abs(math.sin(t)) * 1.0,\n\t\t})\n\tend\n\n\treturn targets\nend\n\n-- 4. 3D Sphere / Globe Formation (Fibonacci Lattice Distribution)\nfunction FormationGenerator.createSphere(\n\tdroneCount: number,\n\tcenter: Vector3,\n\tradius: number?,\n\taltitude: number?\n): { DroneTarget }\n\tlocal r = radius or 25.0\n\tlocal alt = altitude or (DroneConfig.FLIGHT.TAKEOFF_ALTITUDE + 35)\n\tlocal targets: { DroneTarget } = {}\n\tlocal phi = math.pi * (3 - math.sqrt(5)) -- Golden angle\n\n\tfor i = 1, droneCount do\n\t\tlocal y = 1 - ((i - 1) / (droneCount - 1)) * 2 -- y goes from 1 to -1\n\t\tlocal radiusAtY = math.sqrt(1 - y * y)\n\t\tlocal theta = phi * (i - 1)\n\n\t\tlocal x = math.cos(theta) * radiusAtY\n\t\tlocal z = math.sin(theta) * radiusAtY\n\n\t\tlocal worldPos = Vector3.new(center.X + x * r, center.Y + alt + y * r, center.Z + z * r)\n\t\t-- Rainbow gradient by latitude:\n\t\tlocal hue = (y + 1) / 2\n\t\tlocal col = Color3.fromHSV(hue, 0.85, 1.0)\n\n\t\ttable.insert(targets, {\n\t\t\tDroneId = i,\n\t\t\tTargetPosition = worldPos,\n\t\t\tTargetColor = col,\n\t\t\tDelay = (i / droneCount) * 2.0,\n\t\t})\n\tend\n\n\treturn targets\nend\n\n-- 5. Double Helix (DNA Spiral) Formation\nfunction FormationGenerator.createHelix(\n\tdroneCount: number,\n\tcenter: Vector3,\n\theight: number?,\n\tradius: number?\n): { DroneTarget }\n\tlocal h = height or 60.0\n\tlocal r = radius or 12.0\n\tlocal targets: { DroneTarget } = {}\n\tlocal strandCount = math.floor(droneCount / 2)\n\n\tfor strand = 1, 2 do\n\t\tlocal strandOffset = (strand - 1) * math.pi\n\t\tlocal strandColor = if strand == 1 then Color3.fromRGB(0, 255, 255) else Color3.fromRGB(255, 0, 200)\n\n\t\tfor i = 1, strandCount do\n\t\t\tlocal id = (strand - 1) * strandCount + i\n\t\t\tlocal prog = (i - 1) / (strandCount - 1)\n\t\t\tlocal angle = prog * (4 * math.pi) + strandOffset\n\t\t\tlocal y = center.Y + DroneConfig.FLIGHT.TAKEOFF_ALTITUDE + prog * h\n\t\t\tlocal x = center.X + math.cos(angle) * r\n\t\t\tlocal z = center.Z + math.sin(angle) * r\n\n\t\t\ttable.insert(targets, {\n\t\t\t\tDroneId = id,\n\t\t\t\tTargetPosition = Vector3.new(x, y, z),\n\t\t\t\tTargetColor = strandColor,\n\t\t\t\tDelay = prog * 2.0,\n\t\t\t})\n\t\tend\n\tend\n\n\treturn targets\nend\n\nreturn table.freeze(FormationGenerator)\n"
    s.Parent = parent
    print("[DroneInstaller] Installed FormationGenerator (ModuleScript)")
end

do
    local parent = game:GetService("ReplicatedStorage")
    local existing = parent:FindFirstChild("DataExporter")
    if existing then existing:Destroy() end
    local s = Instance.new("ModuleScript")
    s.Name = "DataExporter"
    s.Source = "--!strict\n-- DataExporter.luau\n-- Serializes simulation trajectories to JSON / CSV formats for physical drone firmware loading.\n\nlocal HttpService = game:GetService(\"HttpService\")\nlocal DroneConfig = require(script.Parent.DroneConfig)\nlocal FlightMath = require(script.Parent.FlightMath)\n\nlocal DataExporter = {}\n\nexport type DroneTrajectoryPoint = {\n\tt: number,       -- Time offset in seconds\n\tx: number,       -- East coordinate in meters\n\ty: number,       -- North coordinate in meters\n\tz: number,       -- Altitude in meters (Up)\n\tyaw: number,     -- Heading in degrees\n\tr: number,       -- LED Red (0-255)\n\tg: number,       -- LED Green (0-255)\n\tb: number,       -- LED Blue (0-255)\n}\n\nexport type DroneMissionPlan = {\n\tdrone_id: number,\n\texport_timestamp: number,\n\tsample_rate_hz: number,\n\ttotal_duration_sec: number,\n\tpoints: { DroneTrajectoryPoint },\n}\n\n-- Convert Waypoints list of Roblox coordinates to time-sampled physical metric mission\nfunction DataExporter.generateMissionFromPath(\n\tdroneId: number,\n\twaypoints: { FlightMath.Waypoint },\n\tsampleRateHz: number?,\n\toriginRef: Vector3?\n): DroneMissionPlan\n\tlocal hz = sampleRateHz or 10 -- 10Hz standard telemetry rate\n\tlocal dt = 1 / hz\n\tlocal positions: { Vector3 } = {}\n\n\tfor _, wp in ipairs(waypoints) do\n\t\ttable.insert(positions, wp.Position)\n\tend\n\n\tlocal segLengths, totalLen = FlightMath.calculatePathLengths(positions)\n\tlocal avgSpeed = DroneConfig.FLIGHT.MAX_HORIZONTAL_SPEED\n\tlocal totalDuration = if totalLen > 0 then (totalLen / avgSpeed) else 5.0\n\tlocal totalSamples = math.ceil(totalDuration * hz)\n\n\tlocal missionPoints: { DroneTrajectoryPoint } = {}\n\n\tfor s = 0, totalSamples do\n\t\tlocal t = s * dt\n\t\tlocal dist = (t / totalDuration) * totalLen\n\t\tlocal robloxPos, forwardVec = FlightMath.sampleSplineAtDistance(positions, segLengths, totalLen, dist)\n\n\t\t-- Convert to meters ENU (East, North, Up)\n\t\tlocal metricPos = FlightMath.studsToMetersENU(robloxPos, originRef)\n\n\t\t-- Calculate yaw angle from forward vector\n\t\tlocal yawDeg = math.deg(math.atan2(-forwardVec.X, -forwardVec.Z))\n\t\tif yawDeg < 0 then\n\t\t\tyawDeg += 360\n\t\tend\n\n\t\ttable.insert(missionPoints, {\n\t\t\tt = math.round(t * 100) / 100,\n\t\t\tx = math.round(metricPos.X * 100) / 100,\n\t\t\ty = math.round(metricPos.Y * 100) / 100,\n\t\t\tz = math.round(metricPos.Z * 100) / 100,\n\t\t\tyaw = math.round(yawDeg * 10) / 10,\n\t\t\tr = 0,\n\t\t\tg = 255,\n\t\t\tb = 120,\n\t\t})\n\tend\n\n\treturn {\n\t\tdrone_id = droneId,\n\t\texport_timestamp = os.time(),\n\t\tsample_rate_hz = hz,\n\t\ttotal_duration_sec = math.round(totalDuration * 100) / 100,\n\t\tpoints = missionPoints,\n\t}\nend\n\n-- Export single drone mission to JSON\nfunction DataExporter.exportToJSON(mission: DroneMissionPlan): string\n\treturn HttpService:JSONEncode(mission)\nend\n\n-- Export single drone mission to CSV (t, x_m, y_m, z_m, yaw_deg, r, g, b)\nfunction DataExporter.exportToCSV(mission: DroneMissionPlan): string\n\tlocal lines = {\n\t\t\"# Drone Light Show Trajectory Export\",\n\t\tstring.format(\"# Drone ID: %d | Total Duration: %.2fs | Rate: %d Hz\", mission.drone_id, mission.total_duration_sec, mission.sample_rate_hz),\n\t\t\"time_sec,x_east_m,y_north_m,z_up_m,yaw_deg,led_r,led_g,led_b\"\n\t}\n\n\tfor _, pt in ipairs(mission.points) do\n\t\ttable.insert(lines, string.format(\n\t\t\t\"%.2f,%.3f,%.3f,%.3f,%.1f,%d,%d,%d\",\n\t\t\tpt.t, pt.x, pt.y, pt.z, pt.yaw, pt.r, pt.g, pt.b\n\t\t))\n\tend\n\n\treturn table.concat(lines, \"\\n\")\nend\n\n-- Export entire swarm (all 800 drones) into one consolidated JSON dictionary\nfunction DataExporter.exportSwarmToJSON(swarmMissions: { [number]: DroneMissionPlan }): string\n\tlocal swarmPackage = {\n\t\tproject = \"Drone Light Show Simulation\",\n\t\tcreated_at = os.date(\"!%Y-%m-%dT%H:%M:%SZ\"),\n\t\tdrone_count = 0,\n\t\tdrones = swarmMissions,\n\t}\n\n\tfor _ in pairs(swarmMissions) do\n\t\tswarmPackage.drone_count += 1\n\tend\n\n\treturn HttpService:JSONEncode(swarmPackage)\nend\n\n-- Parse and Import mission from JSON\nfunction DataExporter.importFromJSON(jsonString: string): DroneMissionPlan?\n\tlocal success, result = pcall(function()\n\t\treturn HttpService:JSONDecode(jsonString)\n\tend)\n\n\tif success and type(result) == \"table\" and result.points then\n\t\treturn result :: DroneMissionPlan\n\tend\n\n\twarn(\"[DataExporter] Failed to parse JSON mission:\", result)\n\treturn nil\nend\n\nreturn table.freeze(DataExporter)\n"
    s.Parent = parent
    print("[DroneInstaller] Installed DataExporter (ModuleScript)")
end


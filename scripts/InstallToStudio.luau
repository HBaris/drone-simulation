do
    local parent = game:GetService("StarterPlayer"):WaitForChild("StarterPlayerScripts"):WaitForChild("DroneClient"):WaitForChild("controllers")
    local existing = parent:FindFirstChild("Autopilot")
    if existing then existing:Destroy() end
    local s = Instance.new("ModuleScript")
    s.Name = "Autopilot"
    s.Source = "--!strict\n-- Autopilot.luau\n-- Flight modes and guidance for the primary drone, modelled on ArduPilot Copter:\n--   MANUAL (pilot, altitude-hold style) \u00b7 GUIDED (hold / velocity / go-to / takeoff, driven by a\n--   ground station) \u00b7 AUTO (mission) \u00b7 RTL \u00b7 LAND \u00b7 CRASHED\n-- AUTO flies the same mission tools/sim2mission.py writes (TAKEOFF -> straight legs -> RTL) and the\n-- missions a GCS uploads through the MAVLink bridge (holds, speed changes, RTL/LAND/hold at the end).\n-- Shared singleton: the pilot controller runs it; the route editor and the bridge command it.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal DroneConfig = require(ReplicatedStorage:WaitForChild(\"DroneConfig\"))\n\nlocal S = DroneConfig.STUDS_PER_METER\nlocal AP = DroneConfig.AUTOPILOT\nlocal FS = DroneConfig.FAILSAFE\n\nexport type Mode = \"MANUAL\" | \"GUIDED\" | \"AUTO\" | \"RTL\" | \"LAND\" | \"CRASHED\"\nexport type MissionEnd = \"RTL\" | \"LAND\" | \"HOLD\"\nexport type MissionOptions = {\n\tTakeoffAlt: number?, -- m above home\n\tHolds: { number }?, -- s to wait at each waypoint\n\tSpeeds: { number? }?, -- m/s on the leg into each waypoint (nil = cruise speed)\n\tEnd: MissionEnd?,\n}\n\nlocal GUIDED_VELOCITY_TIMEOUT = 3 -- s, like ArduPilot: stop if the GCS stops sending velocity\n\nlocal Autopilot = {\n\tMode = \"MANUAL\" :: Mode,\n\tArmed = false,\n\tHome = DroneConfig.HOME.SIM_POSITION, -- set where the drone arms, like a real flight controller\n\tStatus = \"\", -- human-readable phase, e.g. \"WP 2/5\" or \"RTL: eve d\u00f6n\u00fcyor\"\n\tLastEvent = \"\", -- last mode change reason / failsafe\n\tMission = {} :: { Vector3 },\n\tMissionOptions = {} :: MissionOptions,\n\tMissionIndex = 0,\n\tPhase = \"\",\n\tPhaseTimer = 0,\n\tClimbTargetY = 0,\n\tLegStart = Vector3.zero, -- start of the current straight leg (cross-track reference)\n\tFailsafeBatteryLow = false,\n\tFailsafeBatteryCritical = false,\n\t-- Live parameters (a GCS can change them through the bridge)\n\tCruiseSpeed = AP.WPNAV_SPEED,\n\tRtlAlt = AP.RTL_ALT,\n\tFenceRadius = FS.FENCE_RADIUS,\n\t-- GUIDED state\n\tGuidedTarget = nil :: Vector3?,\n\tGuidedVelocity = nil :: Vector3?, -- studs/s\n\tGuidedYawRate = 0, -- deg/s, clockwise positive (MAVLink)\n\tGuidedVelocityAge = 0,\n}\n\nfunction Autopilot.setMode(mode: Mode, reason: string?)\n\tif Autopilot.Mode == \"CRASHED\" and mode ~= \"MANUAL\" then\n\t\treturn\n\tend\n\tAutopilot.Mode = mode\n\tAutopilot.Phase = \"\"\n\tAutopilot.PhaseTimer = 0\n\tAutopilot.ClimbTargetY = 0\n\tif mode == \"GUIDED\" then\n\t\tAutopilot.GuidedTarget = nil -- hold wherever the drone is when guidance next runs\n\t\tAutopilot.GuidedVelocity = nil\n\tend\n\tAutopilot.LastEvent = string.format(\"%s%s\", mode, if reason then \" \u2014 \" .. reason else \"\")\n\tprint(\"[Autopilot] Mode:\", Autopilot.LastEvent)\nend\n\nfunction Autopilot.arm(pos: Vector3)\n\tif not Autopilot.Armed then\n\t\tAutopilot.Armed = true\n\t\tAutopilot.Home = pos\n\tend\nend\n\nfunction Autopilot.disarm()\n\tAutopilot.Armed = false\nend\n\n-- Waypoint positions in studs. Mirrors a real mission: take off vertically, fly straight legs,\n-- then RTL (default), LAND at the last point, or HOLD there (ArduCopter's default at mission end).\nfunction Autopilot.startMission(points: { Vector3 }, options: MissionOptions?)\n\tif #points == 0 or Autopilot.Mode == \"CRASHED\" then\n\t\treturn\n\tend\n\tAutopilot.Mission = table.clone(points)\n\tAutopilot.MissionOptions = options or {}\n\tAutopilot.MissionIndex = 0 -- 0 = takeoff leg\n\tAutopilot.setMode(\"AUTO\", string.format(\"%d waypoint\", #points))\nend\n\n-- GUIDED commands from a ground station\nfunction Autopilot.guidedTakeoff(pos: Vector3, altM: number)\n\tif Autopilot.Mode ~= \"GUIDED\" then\n\t\tAutopilot.setMode(\"GUIDED\", \"kalk\u0131\u015f\")\n\tend\n\tAutopilot.GuidedTarget = Vector3.new(pos.X, Autopilot.Home.Y + altM * S, pos.Z)\n\tAutopilot.GuidedVelocity = nil\nend\n\nfunction Autopilot.guidedGoto(target: Vector3)\n\tif Autopilot.Mode ~= \"GUIDED\" then\n\t\tAutopilot.setMode(\"GUIDED\", \"hedefe git\")\n\tend\n\tAutopilot.GuidedTarget = target\n\tAutopilot.GuidedVelocity = nil\nend\n\nfunction Autopilot.guidedVelocityCommand(velocityStuds: Vector3, yawRateDeg: number)\n\tif Autopilot.Mode ~= \"GUIDED\" then\n\t\treturn -- ArduPilot ignores velocity targets outside GUIDED\n\tend\n\tAutopilot.GuidedVelocity = velocityStuds\n\tAutopilot.GuidedYawRate = yawRateDeg\n\tAutopilot.GuidedVelocityAge = 0\nend\n\n-- Heading control in GUIDED (nil = face the direction of travel): the GCS's yaw rate while it sends\n-- velocity, heading held while holding position (like ArduPilot), facing the target on a go-to.\nfunction Autopilot.commandedYawRate(): number?\n\tif Autopilot.Mode ~= \"GUIDED\" then\n\t\treturn nil\n\tend\n\tif Autopilot.GuidedVelocity then\n\t\treturn Autopilot.GuidedYawRate\n\tend\n\treturn if Autopilot.Status == \"GUIDED: konum tutuyor\" then 0 else nil\nend\n\nfunction Autopilot.relAlt(pos: Vector3): number\n\treturn (pos.Y - Autopilot.Home.Y) / S\nend\n\n-- Scale the whole vector (not just Y) to the climb/descent limits so the path stays straight.\nlocal function limitVertical(v: Vector3): Vector3\n\tlocal up, dn = AP.WPNAV_SPEED_UP * S, AP.WPNAV_SPEED_DN * S\n\tif v.Y > up then\n\t\treturn v * (up / v.Y)\n\telseif v.Y < -dn then\n\t\treturn v * (-dn / v.Y)\n\tend\n\treturn v\nend\n\n-- Velocity (studs/s) that flies straight at `target`, respecting ArduPilot speed limits and\n-- braking to `endSpeed` (m/s, 0 = stop on the target).\nlocal function velocityToward(pos: Vector3, target: Vector3, endSpeed: number, cruise: number?): Vector3\n\tlocal delta = target - pos\n\tlocal dist = delta.Magnitude\n\tif dist < 1e-3 then\n\t\treturn Vector3.zero\n\tend\n\tlocal brake = math.sqrt((endSpeed * S) ^ 2 + 2 * AP.WPNAV_ACCEL * S * dist)\n\tlocal speed = math.min((cruise or Autopilot.CruiseSpeed) * S, brake)\n\treturn limitVertical(delta.Unit * speed)\nend\n\nlocal function landVelocity(pos: Vector3, groundY: number?): Vector3\n\t-- Height from the ground raycast (like a rangefinder); without one, altitude above home\n\t-- (what ArduPilot uses from the barometer when no rangefinder is fitted).\n\tlocal heightAboveGround = if groundY then (pos.Y - groundY) / S else Autopilot.relAlt(pos)\n\tlocal speed = if heightAboveGround > AP.LAND_ALT_LOW then AP.LAND_SPEED_HIGH else AP.LAND_SPEED\n\treturn Vector3.new(0, -speed * S, 0)\nend\n\n-- Pure-pursuit \"carrot\" on the straight leg: aim a few meters ahead of the closest point on\n-- the line, so any drift (wind, a sharp corner) is steered back onto the leg.\nlocal LOOKAHEAD_M = 6\nlocal function carrotOnLeg(pos: Vector3, legStart: Vector3, wp: Vector3): Vector3\n\tlocal leg = wp - legStart\n\tlocal len = leg.Magnitude\n\tif len < 1e-3 then\n\t\treturn wp\n\tend\n\tlocal along = math.clamp((pos - legStart):Dot(leg.Unit), 0, len)\n\treturn legStart + leg.Unit * math.min(len, along + LOOKAHEAD_M * S)\nend\n\nlocal function stepAuto(dt: number, pos: Vector3): Vector3\n\tlocal radius = AP.WPNAV_RADIUS * S\n\tlocal options = Autopilot.MissionOptions\n\tif Autopilot.MissionIndex == 0 then\n\t\tlocal takeoffAlt = options.TakeoffAlt or AP.TAKEOFF_ALT\n\t\tlocal target = Vector3.new(pos.X, Autopilot.Home.Y + takeoffAlt * S, pos.Z)\n\t\tAutopilot.Status = string.format(\"KALKI\u015e \u2192 %.0f m\", takeoffAlt)\n\t\t-- Like NAV_TAKEOFF: done once at (or already above) the takeoff altitude\n\t\tif pos.Y >= target.Y - 0.5 * S then\n\t\t\tAutopilot.MissionIndex = 1\n\t\t\tAutopilot.LegStart = pos\n\t\tend\n\t\treturn velocityToward(pos, target, 0)\n\tend\n\n\tlocal mission = Autopilot.Mission\n\tlocal index = Autopilot.MissionIndex\n\tlocal wp = mission[index]\n\tif not wp then\n\t\tlocal finish = options.End or \"RTL\"\n\t\tif finish == \"HOLD\" then\n\t\t\tAutopilot.Status = \"g\u00f6rev bitti \u2014 son noktada bekliyor\"\n\t\t\treturn velocityToward(pos, mission[#mission], 0)\n\t\tend\n\t\tAutopilot.setMode(finish, \"g\u00f6rev tamamland\u0131\")\n\t\treturn Vector3.zero\n\tend\n\n\t-- Waypoint hold time (MISSION_ITEM param1)\n\tif Autopilot.Phase == \"WPHOLD\" then\n\t\tAutopilot.PhaseTimer += dt\n\t\tlocal hold = (options.Holds and options.Holds[index]) or 0\n\t\tAutopilot.Status = string.format(\"WP %d/%d  bekliyor %.0f sn\", index, #mission, hold - Autopilot.PhaseTimer)\n\t\tif Autopilot.PhaseTimer >= hold then\n\t\t\tAutopilot.Phase = \"\"\n\t\t\tAutopilot.MissionIndex += 1\n\t\t\tAutopilot.LegStart = wp\n\t\tend\n\t\treturn velocityToward(pos, wp, 0)\n\tend\n\n\tlocal hold = (options.Holds and options.Holds[index]) or 0\n\tlocal cruise = options.Speeds and options.Speeds[index]\n\tAutopilot.Status = string.format(\"WP %d/%d  %.0f m\", index, #mission, (wp - pos).Magnitude / S)\n\tif (wp - pos).Magnitude < radius then\n\t\tif hold > 0 then\n\t\t\tAutopilot.Phase, Autopilot.PhaseTimer = \"WPHOLD\", 0\n\t\t\treturn velocityToward(pos, wp, 0)\n\t\tend\n\t\tAutopilot.MissionIndex += 1\n\t\tAutopilot.LegStart = wp\n\tend\n\t-- Slow down for the corner into the next leg (a 90\u00b0 turn is taken at 1/4 cruise speed);\n\t-- stop completely if the drone must hold at the waypoint\n\tlocal nextWp = mission[Autopilot.MissionIndex + 1]\n\tlocal cornerSpeed = 0\n\tif hold <= 0 and nextWp and (wp - pos).Magnitude > 1e-3 and (nextWp - wp).Magnitude > 1e-3 then\n\t\tlocal cosTurn = (wp - pos).Unit:Dot((nextWp - wp).Unit)\n\t\tcornerSpeed = (cruise or Autopilot.CruiseSpeed) * ((1 + cosTurn) / 2) ^ 2\n\tend\n\t-- Speed comes from the distance to the waypoint, direction from the carrot on the leg\n\tlocal toWp = velocityToward(pos, wp, cornerSpeed, cruise)\n\tlocal aim = carrotOnLeg(pos, Autopilot.LegStart, wp) - pos\n\treturn if aim.Magnitude > 1e-3 then limitVertical(aim.Unit * toWp.Magnitude) else toWp\nend\n\nlocal function stepGuided(dt: number, pos: Vector3): Vector3\n\tif Autopilot.GuidedVelocity then\n\t\tAutopilot.GuidedVelocityAge += dt\n\t\tif Autopilot.GuidedVelocityAge <= GUIDED_VELOCITY_TIMEOUT then\n\t\t\tlocal v = Autopilot.GuidedVelocity :: Vector3\n\t\t\tAutopilot.Status = string.format(\"GUIDED: h\u0131z %.1f m/s\", v.Magnitude / S)\n\t\t\treturn limitVertical(v)\n\t\tend\n\t\tAutopilot.GuidedVelocity = nil -- command stream stopped: brake and hold here\n\t\tAutopilot.GuidedTarget = pos\n\tend\n\tlocal target = Autopilot.GuidedTarget or pos\n\tAutopilot.GuidedTarget = target\n\tlocal dist = (target - pos).Magnitude / S\n\tAutopilot.Status = if dist > 1 then string.format(\"GUIDED: hedefe %.0f m\", dist) else \"GUIDED: konum tutuyor\"\n\treturn velocityToward(pos, target, 0)\nend\n\nlocal function stepRTL(dt: number, pos: Vector3, groundY: number?): Vector3\n\tlocal home = Autopilot.Home\n\tlocal rtlY = math.max(pos.Y, home.Y + Autopilot.RtlAlt * S)\n\tlocal horizontal = Vector3.new(home.X - pos.X, 0, home.Z - pos.Z).Magnitude\n\n\tif Autopilot.Phase == \"\" then\n\t\tAutopilot.Phase = if horizontal < AP.WPNAV_RADIUS * S then \"LOITER\" else \"CLIMB\"\n\t\tAutopilot.PhaseTimer = 0\n\t\tAutopilot.Status = \"\"\n\tend\n\t-- Climb target is fixed when RTL starts so the return leg is level and straight.\n\tif Autopilot.Phase == \"CLIMB\" then\n\t\tif Autopilot.ClimbTargetY == 0 then\n\t\t\tAutopilot.ClimbTargetY = rtlY\n\t\tend\n\t\tAutopilot.Status = string.format(\"RTL: %.0f m'ye t\u0131rman\u0131yor\", (Autopilot.ClimbTargetY - home.Y) / S)\n\t\tlocal target = Vector3.new(pos.X, Autopilot.ClimbTargetY, pos.Z)\n\t\tif math.abs(pos.Y - target.Y) < 0.5 * S then\n\t\t\tAutopilot.Phase = \"RETURN\"\n\t\tend\n\t\treturn velocityToward(pos, target, 0)\n\telseif Autopilot.Phase == \"RETURN\" then\n\t\tlocal target = Vector3.new(home.X, pos.Y, home.Z)\n\t\tAutopilot.Status = string.format(\"RTL: eve %.0f m\", horizontal / S)\n\t\tif horizontal < 0.5 * S then\n\t\t\tAutopilot.Phase = \"LOITER\"\n\t\t\tAutopilot.PhaseTimer = 0\n\t\tend\n\t\treturn velocityToward(pos, target, 0)\n\telseif Autopilot.Phase == \"LOITER\" then\n\t\tAutopilot.PhaseTimer += dt\n\t\tAutopilot.Status = string.format(\"RTL: ev \u00fcst\u00fcnde bekliyor %.0f sn\", AP.RTL_LOIT_TIME - Autopilot.PhaseTimer)\n\t\tif Autopilot.PhaseTimer >= AP.RTL_LOIT_TIME then\n\t\t\tAutopilot.Phase = \"DESCEND\"\n\t\tend\n\t\treturn velocityToward(pos, Vector3.new(home.X, pos.Y, home.Z), 0)\n\tend\n\tAutopilot.Status = string.format(\"RTL: ini\u015f %.1f m\", Autopilot.relAlt(pos))\n\treturn landVelocity(pos, groundY)\nend\n\n-- Desired velocity (studs/s) for the autonomous modes; nil when the pilot is flying.\nfunction Autopilot.guidance(dt: number, pos: Vector3, groundY: number?): Vector3?\n\tlocal mode = Autopilot.Mode\n\tif mode == \"AUTO\" then\n\t\treturn stepAuto(dt, pos)\n\telseif mode == \"GUIDED\" then\n\t\treturn stepGuided(dt, pos)\n\telseif mode == \"RTL\" then\n\t\treturn stepRTL(dt, pos, groundY)\n\telseif mode == \"LAND\" then\n\t\tAutopilot.Status = string.format(\"\u0130N\u0130\u015e %.1f m\", Autopilot.relAlt(pos))\n\t\treturn landVelocity(pos, groundY)\n\tend\n\tAutopilot.Status = \"\"\n\treturn nil\nend\n\n-- Failsafes checked every frame while armed (battery, geofence), like ArduPilot:\n-- voltage must stay low for BATT_LOW_TIMER so a sag during a hard climb does not trigger it,\n-- and a fence breach triggers RTL once, after which the pilot may take over.\nlocal lowVoltTimer, critVoltTimer, fenceBreached = 0, 0, false\n\nfunction Autopilot.checkFailsafes(dt: number, pos: Vector3, voltage: number)\n\tif not Autopilot.Armed or Autopilot.Mode == \"CRASHED\" then\n\t\treturn\n\tend\n\tcritVoltTimer = if voltage <= FS.BATT_CRT_VOLT then critVoltTimer + dt else 0\n\tlowVoltTimer = if voltage <= FS.BATT_LOW_VOLT then lowVoltTimer + dt else 0\n\tif critVoltTimer >= FS.BATT_LOW_TIMER and not Autopilot.FailsafeBatteryCritical then\n\t\tAutopilot.FailsafeBatteryCritical = true\n\t\tAutopilot.setMode(\"LAND\", string.format(\"KR\u0130T\u0130K BATARYA %.1f V\", voltage))\n\t\treturn\n\tend\n\tif lowVoltTimer >= FS.BATT_LOW_TIMER and not Autopilot.FailsafeBatteryLow then\n\t\tAutopilot.FailsafeBatteryLow = true\n\t\tlocal reason = string.format(\"D\u00dc\u015e\u00dcK BATARYA %.1f V\", voltage)\n\t\tif Autopilot.Mode == \"RTL\" then\n\t\t\tAutopilot.LastEvent = \"RTL \u2014 \" .. reason -- already returning; don't restart the RTL phases\n\t\telseif Autopilot.Mode ~= \"LAND\" then\n\t\t\tAutopilot.setMode(\"RTL\", reason)\n\t\tend\n\t\treturn\n\tend\n\n\tlocal offset = pos - Autopilot.Home\n\tlocal distance = Vector3.new(offset.X, 0, offset.Z).Magnitude / S\n\tlocal outside = distance > Autopilot.FenceRadius or Autopilot.relAlt(pos) > FS.FENCE_ALT_MAX\n\tif outside and not fenceBreached and Autopilot.Mode ~= \"LAND\" then\n\t\tAutopilot.setMode(\"RTL\", string.format(\"GEOFENCE \u0130HLAL\u0130 (%.0f m, %.0f m irtifa)\", distance, Autopilot.relAlt(pos)))\n\tend\n\tfenceBreached = outside\nend\n\n-- ArduPilot fence avoidance (AVOID_ENABLE) in pilot modes: the drone slows down and stops FENCE_MARGIN\n-- inside the altitude ceiling and the circle, instead of flying through and triggering RTL.\n-- `velocity` in studs/s, `estPos` = what the flight controller believes. Returns the allowed velocity.\nfunction Autopilot.fenceLimitVelocity(estPos: Vector3, velocity: Vector3): (Vector3, boolean)\n\tlocal limited = false\n\tlocal v = velocity\n\tlocal ceiling = FS.FENCE_ALT_MAX - FS.FENCE_MARGIN\n\tlocal alt = Autopilot.relAlt(estPos)\n\tif v.Y > 0 then\n\t\tlocal allowed = math.max(0, ceiling - alt) * S -- 1 m/s per meter left: smooth stop at the ceiling\n\t\tif v.Y > allowed then\n\t\t\tv = Vector3.new(v.X, allowed, v.Z)\n\t\t\tlimited = alt > ceiling - 5\n\t\tend\n\tend\n\tlocal offset = Vector3.new(estPos.X - Autopilot.Home.X, 0, estPos.Z - Autopilot.Home.Z)\n\tlocal dist = offset.Magnitude / S\n\tlocal edge = Autopilot.FenceRadius - FS.FENCE_MARGIN\n\tif dist > 1 then\n\t\tlocal out = offset.Unit\n\t\tlocal outward = Vector3.new(v.X, 0, v.Z):Dot(out)\n\t\tlocal allowed = math.max(0, edge - dist) * S\n\t\tif outward > allowed then\n\t\t\tv -= out * (outward - allowed)\n\t\t\tlimited = limited or dist > edge - 10\n\t\tend\n\tend\n\tif limited then\n\t\tAutopilot.Status = string.format(\"\u26a0 SANAL SINIR: tavan %.0f m \u00b7 yar\u0131\u00e7ap %.0f m\", FS.FENCE_ALT_MAX, Autopilot.FenceRadius)\n\tend\n\treturn v, limited\nend\n\nfunction Autopilot.resetFailsafes()\n\tlowVoltTimer, critVoltTimer, fenceBreached = 0, 0, false\n\tAutopilot.FailsafeBatteryLow = false\n\tAutopilot.FailsafeBatteryCritical = false\nend\n\nreturn Autopilot\n"
    s.Parent = parent
    print("[DroneInstaller] Installed Autopilot (ModuleScript)")
end

do
    local parent = game:GetService("StarterPlayer"):WaitForChild("StarterPlayerScripts"):WaitForChild("DroneClient"):WaitForChild("controllers")
    local existing = parent:FindFirstChild("DronePhysics")
    if existing then existing:Destroy() end
    local s = Instance.new("ModuleScript")
    s.Name = "DronePhysics"
    s.Source = "--!strict\n-- DronePhysics.luau\n-- Kinematic multirotor model shared by every flight mode.\n-- Conventions: studs, Y up; Yaw in degrees counter-clockwise (forward = (-sin, 0, -cos));\n-- Pitch > 0 = nose down (accelerating forward); Roll > 0 = right side down.\n-- Wind (m/s, from WindModel) acts through air drag on the air-relative velocity. The flight\n-- controller only knows a lagged wind estimate (like the EKF's), so gusts push the drone off its\n-- path until the estimate catches up, and past the tilt limit the drone cannot hold against it.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal DroneConfig = require(ReplicatedStorage:WaitForChild(\"DroneConfig\"))\n\nlocal S = DroneConfig.STUDS_PER_METER\nlocal GRAVITY = 9.81\nlocal AP = DroneConfig.AUTOPILOT\n\n-- Manual (Angle + altitude hold, like ArduPilot AltHold)\nlocal MAX_SPEED = DroneConfig.FLIGHT.MAX_HORIZONTAL_SPEED * 1.5 -- studs/s (~8.5 m/s)\nlocal CLIMB_RATE = DroneConfig.FLIGHT.MAX_CLIMB_SPEED\nlocal YAW_SPEED = 100.0\nlocal TILT_LIMIT = AP.ANGLE_MAX\nlocal AUTO_LEVEL_SPEED = 6.0\n\nlocal DronePhysics = {}\n\nexport type State = {\n\tPosition: Vector3,\n\tVelocity: Vector3,\n\tYaw: number,\n\tPitch: number,\n\tRoll: number,\n\tThrustAccel: Vector3, -- m/s\u00b2 the rotors produce this frame (excluding gravity) -> motor model\n\tWindEst: Vector3, -- m/s, the controller's estimate of the wind\n\tSaturated: boolean, -- needed more tilt than TILT_LIMIT (losing against the wind)\n}\n\nexport type StickInput = { Forward: number, Right: number, Up: number, Yaw: number } -- each -1..1\n\nfunction DronePhysics.new(position: Vector3, yaw: number): State\n\treturn {\n\t\tPosition = position, Velocity = Vector3.zero, Yaw = yaw, Pitch = 0, Roll = 0,\n\t\tThrustAccel = Vector3.zero, WindEst = Vector3.zero, Saturated = false,\n\t}\nend\n\nfunction DronePhysics.forward(yawDeg: number): Vector3\n\tlocal r = math.rad(yawDeg)\n\treturn Vector3.new(-math.sin(r), 0, -math.cos(r))\nend\n\nfunction DronePhysics.right(yawDeg: number): Vector3\n\tlocal r = math.rad(yawDeg)\n\treturn Vector3.new(math.cos(r), 0, -math.sin(r))\nend\n\nlocal MAX_TILT_ACCEL = GRAVITY * math.tan(math.rad(TILT_LIMIT)) -- m/s\u00b2 of horizontal thrust available\nlocal WIND_ESTIMATE_TAU = 2.0 -- s, how fast the controller learns a change in wind\n\n-- Horizontal acceleration the rotors must produce against air drag (m/s\u00b2) for a ground velocity\n-- (studs/s) in a wind (m/s).\nlocal function dragCompensation(velocity: Vector3, wind: Vector3): Vector3\n\tlocal air = Vector3.new(velocity.X / S - wind.X, 0, velocity.Z / S - wind.Z)\n\treturn air * air.Magnitude * DroneConfig.AIRFRAME.DRAG_COEFF\nend\n\nlocal function horizontal(v: Vector3): Vector3\n\treturn Vector3.new(v.X, 0, v.Z)\nend\n\nlocal function smoothAttitude(s: State, dt: number, targetPitch: number, targetRoll: number)\n\tlocal k = math.min(1, AUTO_LEVEL_SPEED * dt)\n\ts.Pitch += (targetPitch - s.Pitch) * k\n\ts.Roll += (targetRoll - s.Roll) * k\nend\n\n-- Manual (Angle + altitude hold): stick tilt sets the velocity relative to the AIR, so with the\n-- sticks centred the drone drifts with the wind, exactly like ArduPilot AltHold / Stabilize.\nfunction DronePhysics.stepManual(s: State, dt: number, stick: StickInput, wind: Vector3)\n\tsmoothAttitude(s, dt, stick.Forward * TILT_LIMIT, stick.Right * TILT_LIMIT)\n\ts.Yaw = (s.Yaw - stick.Yaw * YAW_SPEED * dt) % 360\n\n\tlocal targetH = DronePhysics.forward(s.Yaw) * (s.Pitch / TILT_LIMIT) * MAX_SPEED\n\t\t+ DronePhysics.right(s.Yaw) * (s.Roll / TILT_LIMIT) * MAX_SPEED\n\t\t+ horizontal(wind) * S\n\tlocal v = s.Velocity\n\tlocal vy = v.Y + (stick.Up * CLIMB_RATE - v.Y) * 0.15 + wind.Y * S * dt\n\tlocal newVelocity = Vector3.new(v.X + (targetH.X - v.X) * 0.1, vy, v.Z + (targetH.Z - v.Z) * 0.1)\n\tlocal kinematic = if dt > 0 then (newVelocity - v) / dt else Vector3.zero\n\ts.Velocity = newVelocity\n\ts.Position += s.Velocity * dt\n\ts.WindEst = wind\n\ts.ThrustAccel = kinematic / S + dragCompensation(s.Velocity, wind)\n\ts.Saturated = false\nend\n\n-- Autonomous modes: follow the autopilot's desired velocity with ArduPilot's acceleration limits\n-- (WPNAV_ACCEL along the path, 2x sideways like WPNAV_ACCEL_C), face the direction of travel and\n-- lean exactly as much as the acceleration + drag requires.\nlocal function clampLength(v: Vector3, maxLen: number): Vector3\n\treturn if v.Magnitude > maxLen then v.Unit * maxLen else v\nend\n\n-- yawRateDeg: heading rate a GCS commanded (clockwise positive); nil = face the direction of travel.\nfunction DronePhysics.stepGuided(s: State, dt: number, desiredVelocity: Vector3, wind: Vector3, yawRateDeg: number?)\n\tlocal dv = desiredVelocity - s.Velocity\n\tlocal along = if desiredVelocity.Magnitude > 1e-3 then desiredVelocity.Unit else Vector3.zero\n\tlocal dvAlong = along * dv:Dot(along)\n\tdv = clampLength(dvAlong, AP.WPNAV_ACCEL * S * dt) + clampLength(dv - dvAlong, 2 * AP.WPNAV_ACCEL * S * dt)\n\tlocal commanded = if dt > 0 then dv / dt / S else Vector3.zero -- m/s\u00b2\n\n\t-- The controller feeds forward drag from its (lagged) wind estimate; the real drag uses the real wind\n\ts.WindEst = s.WindEst:Lerp(wind, math.min(1, dt / WIND_ESTIMATE_TAU))\n\tlocal thrustH = horizontal(commanded) + dragCompensation(s.Velocity, s.WindEst)\n\ts.Saturated = thrustH.Magnitude > MAX_TILT_ACCEL\n\tthrustH = clampLength(thrustH, MAX_TILT_ACCEL)\n\tlocal actualH = thrustH - dragCompensation(s.Velocity, wind)\n\tlocal actualY = commanded.Y + (wind.Y - s.WindEst.Y) -- vertical gusts: 1/s coupling\n\ts.ThrustAccel = Vector3.new(thrustH.X, commanded.Y, thrustH.Z)\n\ts.Velocity += Vector3.new(actualH.X, actualY, actualH.Z) * S * dt\n\ts.Position += s.Velocity * dt\n\n\tlocal hv = Vector3.new(s.Velocity.X, 0, s.Velocity.Z)\n\tif yawRateDeg then\n\t\tlocal rate = math.clamp(yawRateDeg, -AP.YAW_RATE, AP.YAW_RATE)\n\t\ts.Yaw = (s.Yaw - rate * dt) % 360 -- sim yaw turns counter-clockwise\n\telseif hv.Magnitude > 1.0 * S then\n\t\tlocal targetYaw = math.deg(math.atan2(-hv.X, -hv.Z))\n\t\tlocal diff = (targetYaw - s.Yaw + 180) % 360 - 180\n\t\tlocal maxStep = AP.YAW_RATE * dt\n\t\ts.Yaw = (s.Yaw + math.clamp(diff, -maxStep, maxStep)) % 360\n\tend\n\n\tlocal a = thrustH\n\tlocal targetPitch = math.deg(math.atan(a:Dot(DronePhysics.forward(s.Yaw)) / GRAVITY))\n\tlocal targetRoll = math.deg(math.atan(a:Dot(DronePhysics.right(s.Yaw)) / GRAVITY))\n\tsmoothAttitude(s, dt, math.clamp(targetPitch, -TILT_LIMIT, TILT_LIMIT), math.clamp(targetRoll, -TILT_LIMIT, TILT_LIMIT))\nend\n\n-- Lost a motor / crashed: free fall with the frame spinning and flipping.\nfunction DronePhysics.stepCrash(s: State, dt: number, wind: Vector3)\n\ts.Velocity += Vector3.new(0, -GRAVITY * S * dt, 0) - dragCompensation(s.Velocity, wind) * S * dt\n\ts.ThrustAccel = Vector3.zero\n\ts.Velocity *= (1 - 0.3 * dt)\n\ts.Position += s.Velocity * dt\n\ts.Yaw = (s.Yaw + 540 * dt) % 360\n\ts.Roll = math.min(s.Roll + 90 * dt, 70)\nend\n\nfunction DronePhysics.cframe(s: State): CFrame\n\t-- Negative X rotation tips the nose (-Z) down for positive pitch.\n\treturn CFrame.new(s.Position) * CFrame.Angles(0, math.rad(s.Yaw), 0) * CFrame.Angles(-math.rad(s.Pitch), 0, -math.rad(s.Roll))\nend\n\nreturn DronePhysics\n"
    s.Parent = parent
    print("[DroneInstaller] Installed DronePhysics (ModuleScript)")
end

do
    local parent = game:GetService("StarterPlayer"):WaitForChild("StarterPlayerScripts"):WaitForChild("DroneClient"):WaitForChild("controllers")
    local existing = parent:FindFirstChild("FlightEnvironment")
    if existing then existing:Destroy() end
    local s = Instance.new("ModuleScript")
    s.Name = "FlightEnvironment"
    s.Source = "--!strict\n-- FlightEnvironment.luau\n-- Raycasts the world around the drone: ground height below it (for take-off / landing) and\n-- obstacles along its movement (buildings, bridge towers, sea) for crash detection.\n\nlocal Players = game:GetService(\"Players\")\nlocal Workspace = game:GetService(\"Workspace\")\n\nlocal FlightEnvironment = {}\n\nlocal DRONE_HALF_HEIGHT = 0.4 -- studs from the model pivot to the landing gear\nlocal GROUND_PROBE = 2000\n\nlocal params = RaycastParams.new()\nparams.FilterType = Enum.RaycastFilterType.Exclude\nparams.IgnoreWater = false\n\nlocal function refreshFilter()\n\tlocal ignore: { Instance } = {}\n\tlocal swarm = Workspace:FindFirstChild(\"DroneSwarm\")\n\tif swarm then\n\t\ttable.insert(ignore, swarm)\n\tend\n\tlocal character = Players.LocalPlayer and Players.LocalPlayer.Character\n\tif character then\n\t\ttable.insert(ignore, character)\n\tend\n\tparams.FilterDescendantsInstances = ignore\nend\n\n-- Resting height of the drone pivot on whatever is below `pos` (nil over the void), and the hit.\nfunction FlightEnvironment.groundY(pos: Vector3): (number?, RaycastResult?)\n\trefreshFilter()\n\tlocal hit = Workspace:Raycast(pos + Vector3.new(0, 1, 0), Vector3.new(0, -GROUND_PROBE, 0), params)\n\tif not hit then\n\t\treturn nil, nil\n\tend\n\treturn hit.Position.Y + DRONE_HALF_HEIGHT, hit\nend\n\n-- First obstacle between two drone positions (padded by the drone's size), or nil.\nfunction FlightEnvironment.obstacleBetween(fromPos: Vector3, toPos: Vector3): RaycastResult?\n\tlocal delta = toPos - fromPos\n\tif delta.Magnitude < 1e-3 then\n\t\treturn nil\n\tend\n\trefreshFilter()\n\tlocal padded = delta + delta.Unit * 1.2\n\treturn Workspace:Raycast(fromPos, padded, params)\nend\n\n-- Fraction of the sky blocked around `pos` (0 open .. 1 urban canyon): rays toward where GPS satellites\n-- sit (35\u00b0 elevation, 12 azimuths) that hit a building within 70 m. Drives the GPS model's multipath.\nlocal SKY_RAYS = 12\nlocal SKY_ELEVATION = math.rad(35)\nlocal SKY_RANGE = 70 * 3.5\nfunction FlightEnvironment.skyObstruction(pos: Vector3): number\n\trefreshFilter()\n\tlocal blocked = 0\n\tfor k = 0, SKY_RAYS - 1 do\n\t\tlocal az = k * 2 * math.pi / SKY_RAYS\n\t\tlocal dir = Vector3.new(math.cos(az) * math.cos(SKY_ELEVATION), math.sin(SKY_ELEVATION), math.sin(az) * math.cos(SKY_ELEVATION))\n\t\tif Workspace:Raycast(pos, dir * SKY_RANGE, params) then\n\t\t\tblocked += 1\n\t\tend\n\tend\n\treturn blocked / SKY_RAYS\nend\n\nreturn FlightEnvironment\n"
    s.Parent = parent
    print("[DroneInstaller] Installed FlightEnvironment (ModuleScript)")
end

do
    local parent = game:GetService("StarterPlayer"):WaitForChild("StarterPlayerScripts"):WaitForChild("DroneClient"):WaitForChild("controllers")
    local existing = parent:FindFirstChild("BridgeClient")
    if existing then existing:Destroy() end
    local s = Instance.new("ModuleScript")
    s.Name = "BridgeClient"
    s.Source = "--!strict\n-- BridgeClient.luau\n-- Client half of the MAVLink bridge: packs the drone state for BridgeLink.server (ENU meters\n-- relative to the launch pad, MAVLink sign conventions) and executes ground-station commands.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal DroneConfig = require(ReplicatedStorage:WaitForChild(\"DroneConfig\"))\nlocal Autopilot = require(script.Parent:WaitForChild(\"Autopilot\"))\n\nlocal S = DroneConfig.STUDS_PER_METER\nlocal PAD = DroneConfig.HOME.SIM_POSITION\n\nlocal BridgeClient = {}\n\nexport type Context = {\n\tDrone: any, -- DronePhysics.State\n\tTelemetry: any, -- DroneHealthModel.Telemetry\n\tWind: Vector3,\n\tOnGround: boolean,\n\tCrash: string,\n\tYawRate: number, -- deg/s, clockwise positive\n\tEstPosition: Vector3, -- what the flight controller believes (GPS/EKF); a GCS sees this, not the truth\n\tGpsSats: number,\n\tHdop: number,\n}\n\n-- Controller hooks for commands the autopilot alone cannot carry out\nexport type Hooks = {\n\tArm: () -> boolean,\n\tDisarm: (force: boolean) -> (),\n\tReset: () -> (),\n\tMotorTest: (motor: number, pct: number, seconds: number, delay: number) -> (),\n\tFault: (motor: number, efficiency: number) -> (),\n}\n\nfunction BridgeClient.enuToSim(e: number, n: number, u: number): Vector3\n\treturn PAD + Vector3.new(e * S, u * S, -n * S)\nend\n\nlocal function simToEnu(v: Vector3): (number, number, number)\n\treturn v.X / S, -v.Z / S, v.Y / S\nend\n\nlocal function round(x: number, digits: number): number\n\tlocal m = 10 ^ digits\n\treturn math.round(x * m) / m\nend\n\nfunction BridgeClient.buildState(ctx: Context): { [string]: any }\n\tlocal d, t = ctx.Drone, ctx.Telemetry\n\tlocal e, n, u = simToEnu(ctx.EstPosition - PAD)\n\tlocal ve, vn, vu = simToEnu(d.Velocity)\n\tlocal he, hn, hu = simToEnu(Autopilot.Home - PAD)\n\tlocal motors, rpm, temps, currents = {}, {}, {}, {}\n\tfor i, m in ipairs(t.Motors) do\n\t\tmotors[i], rpm[i], temps[i], currents[i] = round(m.Output, 3), math.round(m.Rpm), round(m.TempC, 1), round(m.CurrentA, 2)\n\tend\n\treturn {\n\t\tmode = Autopilot.Mode,\n\t\tarmed = Autopilot.Armed,\n\t\tstatus = Autopilot.Status,\n\t\tevent = Autopilot.LastEvent,\n\t\tcrash = ctx.Crash,\n\t\ton_ground = ctx.OnGround,\n\t\tmission_index = Autopilot.MissionIndex,\n\t\te = round(e, 3), n = round(n, 3), u = round(u, 3),\n\t\tve = round(ve, 3), vn = round(vn, 3), vu = round(vu, 3),\n\t\thome_e = round(he, 3), home_n = round(hn, 3), home_u = round(hu, 3),\n\t\theading = round((-d.Yaw) % 360, 2),\n\t\tpitch = round(-d.Pitch, 2), -- MAVLink: nose up positive; sim: nose down positive\n\t\troll = round(d.Roll, 2),\n\t\tyaw_rate = round(ctx.YawRate, 2),\n\t\tvoltage = round(t.VoltageV, 3), cell_v = round(t.CellV, 3), current = round(t.CurrentA, 2),\n\t\tused_mah = round(t.UsedMah, 1), remaining = math.floor(t.RemainingPct),\n\t\tmotors = motors, rpm = rpm, temps = temps, motor_currents = currents,\n\t\twind = { round(ctx.Wind.X, 2), round(-ctx.Wind.Z, 2), round(ctx.Wind.Y, 2) },\n\t\thome_geo = DroneConfig.HOME.GEO,\n\t\tgps_sats = ctx.GpsSats,\n\t\thdop = round(ctx.Hdop, 2),\n\t}\nend\n\n-- Executes one command from the bridge (see tools/dronebridge/mavsim.py for the producer).\nfunction BridgeClient.execute(c: { [string]: any }, drone: any, hooks: Hooks)\n\tlocal kind = c.type\n\tif kind == \"arm\" then\n\t\thooks.Arm()\n\telseif kind == \"disarm\" then\n\t\thooks.Disarm(c.force == true)\n\telseif kind == \"mode\" then\n\t\tlocal mode = c.mode\n\t\tif mode == \"HOLD\" then\n\t\t\tAutopilot.setMode(\"GUIDED\", c.reason or \"konum tut\")\n\t\telseif mode == \"MANUAL\" or mode == \"GUIDED\" then\n\t\t\t-- ArduCopter lets you pick these on the ground (TEI flow: GUIDED -> ARM -> TAKEOFF)\n\t\t\tAutopilot.setMode(mode, c.reason or \"yer istasyonu\")\n\t\telseif mode == \"RTL\" or mode == \"LAND\" then\n\t\t\tif Autopilot.Armed then -- only meaningful in the air\n\t\t\t\tAutopilot.setMode(mode, c.reason or \"yer istasyonu\")\n\t\t\tend\n\t\tend\n\telseif kind == \"takeoff\" then\n\t\tif Autopilot.Armed then\n\t\t\tAutopilot.guidedTakeoff(drone.Position, c.alt)\n\t\tend\n\telseif kind == \"velocity\" then\n\t\tAutopilot.guidedVelocityCommand(Vector3.new(c.ve * S, c.vu * S, -c.vn * S), c.yaw_rate or 0)\n\telseif kind == \"goto\" then\n\t\tAutopilot.guidedGoto(BridgeClient.enuToSim(c.e, c.n, c.u))\n\telseif kind == \"mission\" then\n\t\tlocal points, holds, speeds = {}, {}, {}\n\t\tfor i, p in ipairs(c.points) do\n\t\t\tpoints[i] = BridgeClient.enuToSim(p.e, p.n, p.u)\n\t\t\tholds[i] = p.hold or 0\n\t\t\tspeeds[i] = p.speed\n\t\tend\n\t\tif hooks.Arm() then\n\t\t\tAutopilot.startMission(points, { TakeoffAlt = c.takeoff_alt, Holds = holds, Speeds = speeds, End = c[\"end\"] })\n\t\tend\n\telseif kind == \"fault\" then\n\t\thooks.Fault(c.motor, c.efficiency)\n\telseif kind == \"motortest\" then\n\t\thooks.MotorTest(c.motor, c.pct, c.seconds, c.delay or 0)\n\telseif kind == \"param\" then\n\t\tif c.name == \"cruise_speed\" then\n\t\t\tAutopilot.CruiseSpeed = math.clamp(c.value, 1, 20)\n\t\telseif c.name == \"rtl_alt\" then\n\t\t\tAutopilot.RtlAlt = math.clamp(c.value, 2, 120)\n\t\telseif c.name == \"fence_radius\" then\n\t\t\tAutopilot.FenceRadius = math.max(c.value, 10)\n\t\tend\n\telseif kind == \"reset\" then\n\t\thooks.Reset()\n\tend\nend\n\nreturn BridgeClient\n"
    s.Parent = parent
    print("[DroneInstaller] Installed BridgeClient (ModuleScript)")
end

do
    local parent = game:GetService("StarterPlayer"):WaitForChild("StarterPlayerScripts"):WaitForChild("DroneClient"):WaitForChild("controllers")
    local existing = parent:FindFirstChild("GpsModel")
    if existing then existing:Destroy() end
    local s = Instance.new("ModuleScript")
    s.Name = "GpsModel"
    s.Source = "--!strict\n-- GpsModel.luau\n-- Position estimate the flight controller believes (GPS + barometer through the EKF), which drifts\n-- away from the true position. The autopilot navigates on this estimate, so the true drone wanders\n-- by the error \u2014 hover drift, landing offset \u2014 exactly like a real Pixhawk with an M8N.\n-- Error: first-order Gauss-Markov per axis (slow wander), scaled by HDOP; buildings blocking the sky\n-- (FlightEnvironment.skyObstruction) cut satellites, raise HDOP and cause multipath jumps.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal DroneConfig = require(ReplicatedStorage:WaitForChild(\"DroneConfig\"))\n\nlocal G = DroneConfig.GPS\nlocal S = DroneConfig.STUDS_PER_METER\n\nlocal GpsModel = {}\nGpsModel.__index = GpsModel\n\nexport type Gps = typeof(setmetatable(\n\t{} :: {\n\t\tError: Vector3, -- meters (east, up, south = Roblox axes)\n\t\tGlitch: Vector3, -- meters, decaying multipath jump\n\t\tObstruction: number,\n\t\tSats: number,\n\t\tHdop: number,\n\t\tRng: Random,\n\t},\n\tGpsModel\n))\n\nfunction GpsModel.new(seed: number?): Gps\n\treturn setmetatable({\n\t\tError = Vector3.zero,\n\t\tGlitch = Vector3.zero,\n\t\tObstruction = 0,\n\t\tSats = G.SATS_OPEN,\n\t\tHdop = G.HDOP_OPEN,\n\t\tRng = Random.new(seed or os.time()),\n\t}, GpsModel)\nend\n\nlocal function gaussian(rng: Random): number\n\t-- Box-Muller\n\tlocal u1 = math.max(rng:NextNumber(), 1e-9)\n\treturn math.sqrt(-2 * math.log(u1)) * math.cos(2 * math.pi * rng:NextNumber())\nend\n\nfunction GpsModel.setObstruction(self: Gps, fraction: number)\n\tself.Obstruction = fraction\n\tself.Sats = math.max(0, math.round(G.SATS_OPEN - (G.SATS_OPEN - 4) * fraction))\n\tself.Hdop = G.HDOP_OPEN * (1 + 3 * fraction * fraction)\nend\n\n-- Advance the error and return the estimated position (studs) for the true position.\nfunction GpsModel.step(self: Gps, dt: number, truePos: Vector3): Vector3\n\tif not G.ENABLED then\n\t\treturn truePos\n\tend\n\tlocal scale = self.Hdop / G.HDOP_OPEN\n\tlocal k = math.sqrt(2 * dt / G.TAU_S)\n\tlocal decay = dt / G.TAU_S\n\tlocal sh, sv = G.SIGMA_H_M * scale, G.SIGMA_V_M\n\tlocal e = self.Error\n\tself.Error = Vector3.new(\n\t\te.X - e.X * decay + sh * k * gaussian(self.Rng),\n\t\te.Y - e.Y * decay + sv * k * gaussian(self.Rng),\n\t\te.Z - e.Z * decay + sh * k * gaussian(self.Rng)\n\t)\n\n\t-- Multipath: reflected signals near buildings make the fix jump; the EKF slowly rejects it\n\tself.Glitch *= math.exp(-dt / 4)\n\tlocal rate = G.GLITCH_RATE * math.max(0, self.Obstruction - 0.3) / 0.7\n\tif self.Rng:NextNumber() < rate * dt then\n\t\tlocal az = self.Rng:NextNumber() * 2 * math.pi\n\t\tlocal size = G.GLITCH_M[1] + (G.GLITCH_M[2] - G.GLITCH_M[1]) * self.Rng:NextNumber()\n\t\tself.Glitch += Vector3.new(math.cos(az) * size, 0, math.sin(az) * size)\n\tend\n\treturn truePos + (self.Error + self.Glitch) * S\nend\n\n-- Horizontal error magnitude in meters (for the health panel / telemetry)\nfunction GpsModel.horizontalError(self: Gps): number\n\tlocal total = self.Error + self.Glitch\n\treturn Vector3.new(total.X, 0, total.Z).Magnitude\nend\n\nreturn GpsModel\n"
    s.Parent = parent
    print("[DroneInstaller] Installed GpsModel (ModuleScript)")
end


do
    local parent = game:GetService("ServerScriptService"):WaitForChild("DroneSystem")
    local existing = parent:FindFirstChild("DroneSpawner")
    if existing then existing:Destroy() end
    local s = Instance.new("ModuleScript")
    s.Name = "DroneSpawner"
    s.Source = "--!strict\n-- DroneSpawner.luau\n-- Procedural Quadcopter Model Generator with LED Light Show emitters and optimized LODs.\n\nlocal DroneConfig = require(game:GetService(\"ReplicatedStorage\"):WaitForChild(\"DroneConfig\"))\n\nlocal DroneSpawner = {}\n\n-- Weld everything to the anchored chassis: the swarm/show loops BulkMoveTo only the PrimaryPart,\n-- and separately anchored parts (LED, arms, rotors) would stay behind on the ground.\nlocal function weldToChassis(model: Model, chassis: BasePart)\n\tfor _, part in model:GetDescendants() do\n\t\tif part:IsA(\"BasePart\") and part ~= chassis then\n\t\t\tlocal weld = Instance.new(\"WeldConstraint\")\n\t\t\tweld.Part0 = chassis\n\t\t\tweld.Part1 = part\n\t\t\tweld.Parent = part\n\t\t\tpart.Anchored = false\n\t\t\tpart.Massless = true\n\t\tend\n\tend\nend\n\n-- Creates a sleek procedural Quadcopter Model\nfunction DroneSpawner.createQuadcopterModel(droneId: number, isHighDetail: boolean?): Model\n\tlocal highDetail = if isHighDetail ~= nil then isHighDetail else true\n\tlocal model = Instance.new(\"Model\")\n\tmodel.Name = string.format(\"Drone_%03d\", droneId)\n\n\t-- 1. Main Central Chassis (Root Part)\n\tlocal chassis = Instance.new(\"Part\")\n\tchassis.Name = \"Chassis\"\n\tchassis.Size = Vector3.new(1.2, 0.35, 1.2)\n\tchassis.Material = Enum.Material.SmoothPlastic\n\tchassis.Color = Color3.fromRGB(25, 25, 28)\n\tchassis.CastShadow = false\n\tchassis.Anchored = true\n\tchassis.CanCollide = false\n\tchassis.Parent = model\n\tmodel.PrimaryPart = chassis\n\n\t-- 2. Powerful Bottom LED Show Light (The star of light shows)\n\tlocal led = Instance.new(\"Part\")\n\tled.Name = \"ShowLED\"\n\tled.Shape = Enum.PartType.Ball\n\tled.Size = Vector3.new(0.6, 0.6, 0.6)\n\tled.Material = Enum.Material.Neon\n\tled.Color = DroneConfig.DRONE_MODEL.LED_DEFAULT_COLOR\n\tled.CastShadow = false\n\tled.Anchored = true\n\tled.CanCollide = false\n\tled.CFrame = chassis.CFrame * CFrame.new(0, -0.2, 0)\n\tled.Parent = model\n\n\tlocal pointLight = Instance.new(\"PointLight\")\n\tpointLight.Name = \"LightSource\"\n\tpointLight.Color = led.Color\n\tpointLight.Brightness = DroneConfig.DRONE_MODEL.LED_BRIGHTNESS\n\tpointLight.Range = 18\n\tpointLight.Shadows = false\n\tpointLight.Parent = led\n\n\t-- Light trail for visual choreography arcs\n\tif DroneConfig.LIGHT_SHOW.ENABLE_TRAILS then\n\t\tlocal att0 = Instance.new(\"Attachment\")\n\t\tatt0.Position = Vector3.new(0, -0.3, 0)\n\t\tatt0.Parent = led\n\n\t\tlocal att1 = Instance.new(\"Attachment\")\n\t\tatt1.Position = Vector3.new(0, 0.3, 0)\n\t\tatt1.Parent = led\n\n\t\tlocal trail = Instance.new(\"Trail\")\n\t\ttrail.Name = \"LightTrail\"\n\t\ttrail.Attachment0 = att0\n\t\ttrail.Attachment1 = att1\n\t\ttrail.Color = ColorSequence.new(led.Color)\n\t\ttrail.Lifetime = DroneConfig.LIGHT_SHOW.TRAIL_LIFETIME\n\t\ttrail.Transparency = NumberSequence.new({\n\t\t\tNumberSequenceKeypoint.new(0, 0.2),\n\t\t\tNumberSequenceKeypoint.new(1, 1.0),\n\t\t})\n\t\ttrail.Parent = led\n\tend\n\n\t-- If low detail mode (used for massive swarms > 300 drones), return early to maximize FPS\n\tif not highDetail then\n\t\tweldToChassis(model, chassis)\n\t\treturn model\n\tend\n\n\t-- 3. Quadcopter Arms (X Configuration)\n\tlocal armOffsets = {\n\t\t-- Forward is -Z. ArduPilot numbers (DroneHealthModel.MOTORS) are mapped by position.\n\t\tVector3.new(0.9, 0, 0.9),   -- Rear-Right (ArduPilot M4)\n\t\tVector3.new(-0.9, 0, 0.9),  -- Rear-Left  (ArduPilot M2)\n\t\tVector3.new(0.9, 0, -0.9),  -- Front-Right (ArduPilot M1)\n\t\tVector3.new(-0.9, 0, -0.9), -- Front-Left  (ArduPilot M3)\n\t}\n\n\tfor i, offset in ipairs(armOffsets) do\n\t\t-- Arm strut\n\t\tlocal arm = Instance.new(\"Part\")\n\t\tarm.Name = \"Arm_\" .. i\n\t\tarm.Size = Vector3.new(0.2, 0.15, 1.2)\n\t\tarm.Material = Enum.Material.SmoothPlastic\n\t\tarm.Color = Color3.fromRGB(40, 40, 45)\n\t\tarm.Anchored = true\n\t\tarm.CanCollide = false\n\t\tarm.CFrame = chassis.CFrame * CFrame.new(offset.X * 0.5, 0, offset.Z * 0.5) * CFrame.Angles(0, math.atan2(offset.X, offset.Z), 0)\n\t\tarm.Parent = model\n\n\t\t-- Motor Pod\n\t\tlocal motor = Instance.new(\"Part\")\n\t\tmotor.Name = \"Motor_\" .. i\n\t\tmotor.Shape = Enum.PartType.Cylinder\n\t\tmotor.Size = Vector3.new(0.35, 0.4, 0.4)\n\t\tmotor.Material = Enum.Material.Metal\n\t\tmotor.Color = Color3.fromRGB(15, 15, 15)\n\t\tmotor.Anchored = true\n\t\tmotor.CanCollide = false\n\t\t-- Align cylinder vertically\n\t\tmotor.CFrame = chassis.CFrame * CFrame.new(offset) * CFrame.Angles(0, 0, math.rad(90))\n\t\tmotor.Parent = model\n\n\t\t-- Rotor Blade Disc\n\t\tlocal rotor = Instance.new(\"Part\")\n\t\trotor.Name = \"Rotor_\" .. i\n\t\trotor.Shape = Enum.PartType.Cylinder\n\t\trotor.Size = Vector3.new(0.04, 1.1, 1.1)\n\t\trotor.Material = Enum.Material.Glass\n\t\trotor.Color = Color3.fromRGB(200, 200, 200)\n\t\trotor.Transparency = 0.65\n\t\trotor.Anchored = true\n\t\trotor.CanCollide = false\n\t\trotor.CFrame = chassis.CFrame * CFrame.new(offset + Vector3.new(0, 0.22, 0)) * CFrame.Angles(0, 0, math.rad(90))\n\t\trotor.Parent = model\n\tend\n\n\tweldToChassis(model, chassis)\n\treturn model\nend\n\nreturn table.freeze(DroneSpawner)\n"
    s.Parent = parent
    print("[DroneInstaller] Installed DroneSpawner (ModuleScript)")
end

do
    local parent = game:GetService("ServerScriptService"):WaitForChild("DroneSystem")
    local existing = parent:FindFirstChild("FlightManager")
    if existing then existing:Destroy() end
    local s = Instance.new("Script")
    s.Name = "FlightManager"
    s.Source = "--!strict\n-- FlightManager.server.luau\n-- Server-side coordinator for Drone Swarm Spawning, Choreography Execution, and Remote Network API.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\nlocal Workspace = game:GetService(\"Workspace\")\n\nlocal DroneConfig = require(ReplicatedStorage:WaitForChild(\"DroneConfig\"))\nlocal FlightMath = require(ReplicatedStorage:WaitForChild(\"FlightMath\"))\nlocal FormationGenerator = require(ReplicatedStorage:WaitForChild(\"FormationGenerator\"))\nlocal DataExporter = require(ReplicatedStorage:WaitForChild(\"DataExporter\"))\nlocal DroneSpawner = require(script.Parent:WaitForChild(\"DroneSpawner\"))\nlocal ShowPlayer = require(script.Parent:WaitForChild(\"ShowPlayer\"))\n\n-- Network Remotes Setup\nlocal NetworkFolder = ReplicatedStorage:FindFirstChild(\"DroneNetwork\")\nif not NetworkFolder then\n\tNetworkFolder = Instance.new(\"Folder\")\n\tNetworkFolder.Name = \"DroneNetwork\"\n\tNetworkFolder.Parent = ReplicatedStorage\nend\n\nlocal function getOrCreateRemote<T>(className: string, name: string): T\n\tlocal remote = NetworkFolder:FindFirstChild(name)\n\tif not remote then\n\t\tremote = Instance.new(className)\n\t\tremote.Name = name\n\t\tremote.Parent = NetworkFolder\n\tend\n\treturn remote :: any\nend\n\nlocal StartFlightEvent = getOrCreateRemote(\"RemoteEvent\", \"StartFlight\")\nlocal StopFlightEvent = getOrCreateRemote(\"RemoteEvent\", \"StopFlight\")\nlocal SetFormationEvent = getOrCreateRemote(\"RemoteEvent\", \"SetFormation\")\nlocal ExportDataFunction = getOrCreateRemote(\"RemoteFunction\", \"ExportMissionData\")\n\n-- Workspace Container\nlocal SwarmFolder = Workspace:FindFirstChild(\"DroneSwarm\")\nif not SwarmFolder then\n\tSwarmFolder = Instance.new(\"Folder\")\n\tSwarmFolder.Name = \"DroneSwarm\"\n\tSwarmFolder.Parent = Workspace\nend\n\n-- Active State\ntype ActiveDroneState = {\n\tId: number,\n\tModel: Model,\n\tCurrentPos: Vector3,\n\tTargetPos: Vector3,\n\tCurrentColor: Color3,\n\tDelayRemaining: number,\n\tSpeed: number,\n}\n\nlocal activeDrones: { [number]: ActiveDroneState } = {}\nlocal isSimulating = false\nlocal monitorSeparation: (dt: number) -> ()\nlocal currentWaypoints: { FlightMath.Waypoint } = {}\n\n-- Ensure N drones exist in SwarmFolder\nlocal function syncDroneCount(count: number)\n\tcount = math.clamp(count, 1, DroneConfig.SWARM.MAX_DRONES)\n\n\t-- Destroy excess drones\n\tfor id, state in pairs(activeDrones) do\n\t\tif id > count then\n\t\t\tif state.Model then\n\t\t\t\tstate.Model:Destroy()\n\t\t\tend\n\t\t\tactiveDrones[id] = nil\n\t\tend\n\tend\n\n\t-- Create missing drones\n\tlocal isLowDetail = count > 200\n\tfor id = 1, count do\n\t\tif not activeDrones[id] then\n\t\t\tlocal model = DroneSpawner.createQuadcopterModel(id, not isLowDetail)\n\t\t\t-- Drone 1 sits on the active site's launch pad (flown client-side); show drones line up\n\t\t\t-- in a grid beside it so the swarm takes off where the player is\n\t\t\tlocal pad = DroneConfig.HOME.SIM_POSITION\n\t\t\tlocal spawnPos = if id == 1 then pad else pad + Vector3.new(8 + ((id - 2) % 10) * 3, 0, math.floor((id - 2) / 10) * 3)\n\t\t\tmodel:PivotTo(CFrame.new(spawnPos) * CFrame.Angles(0, math.rad(-90), 0))\n\t\t\t-- Real-site maps are far from the origin; without this the client never streams the swarm in\n\t\t\tmodel.ModelStreamingMode = Enum.ModelStreamingMode.Persistent\n\t\t\tmodel.Parent = SwarmFolder\n\n\t\t\tactiveDrones[id] = {\n\t\t\t\tId = id,\n\t\t\t\tModel = model,\n\t\t\t\tCurrentPos = spawnPos,\n\t\t\t\tTargetPos = spawnPos,\n\t\t\t\tCurrentColor = DroneConfig.DRONE_MODEL.LED_DEFAULT_COLOR,\n\t\t\t\tDelayRemaining = 0,\n\t\t\t\tSpeed = DroneConfig.FLIGHT.MAX_HORIZONTAL_SPEED,\n\t\t\t}\n\t\tend\n\tend\nend\n\n-- Initialize single drone on the Helipad by default (no automatic swarm!)\nsyncDroneCount(1)\n\n-- Handle Formations\nSetFormationEvent.OnServerEvent:Connect(function(player, formationType: string, count: number, scale: number?)\n\tprint(string.format(\"[FlightManager] Player %s requested formation '%s' with %d drones.\", player.Name, formationType, count))\n\tif formationType == \"Planned\" then\n\t\t-- Collision-free show from tools/plan_show.py; replaces the ad-hoc formation drones\n\t\tsyncDroneCount(1)\n\t\tShowPlayer.start(ShowPlayer.load(require(script.Parent:WaitForChild(\"ShowData\") :: any)), SwarmFolder)\n\t\tisSimulating = true\n\t\treturn\n\tend\n\tShowPlayer.stop()\n\t-- Drone_001 belongs to the client autopilot, so the show uses drones 2..count+1\n\tcount = math.clamp(count, 1, DroneConfig.SWARM.MAX_DRONES - 1)\n\tsyncDroneCount(count + 1)\n\n\tlocal center = DroneConfig.HOME.SHOW_CENTER + Vector3.new(0, DroneConfig.HOME.SHOW_LIFT, 0)\n\tlocal targets: { FormationGenerator.DroneTarget } = {}\n\n\tif formationType == \"Grid\" then\n\t\ttargets = FormationGenerator.createGrid(count, center, 4 * (scale or 1))\n\telseif formationType == \"Circle\" then\n\t\ttargets = FormationGenerator.createCircle(count, center, nil, nil)\n\telseif formationType == \"Heart\" then\n\t\ttargets = FormationGenerator.createHeart(count, center, scale or 1.5)\n\telseif formationType == \"Sphere\" then\n\t\ttargets = FormationGenerator.createSphere(count, center, 25 * (scale or 1))\n\telseif formationType == \"Helix\" then\n\t\ttargets = FormationGenerator.createHelix(count, center)\n\tend\n\n\tfor _, tgt in ipairs(targets) do\n\t\tlocal drone = activeDrones[tgt.DroneId + 1]\n\t\tif drone then\n\t\t\tdrone.TargetPos = tgt.TargetPosition\n\t\t\tdrone.DelayRemaining = tgt.Delay\n\t\t\tdrone.CurrentColor = tgt.TargetColor\n\n\t\t\t-- Update LED immediately\n\t\t\tlocal ledPart = drone.Model:FindFirstChild(\"ShowLED\") :: Part?\n\t\t\tif ledPart then\n\t\t\t\tledPart.Color = tgt.TargetColor\n\t\t\t\tlocal light = ledPart:FindFirstChild(\"LightSource\") :: PointLight?\n\t\t\t\tif light then\n\t\t\t\t\tlight.Color = tgt.TargetColor\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\n\tisSimulating = true\nend)\n\n-- Handle Single / Multi Waypoint Path Flight\nStartFlightEvent.OnServerEvent:Connect(function(player, waypoints: { FlightMath.Waypoint })\n\tif not waypoints or #waypoints < 2 then\n\t\twarn(\"[FlightManager] Need at least 2 waypoints to start flight.\")\n\t\treturn\n\tend\n\n\tcurrentWaypoints = waypoints\n\tsyncDroneCount(1) -- Single drone editor run\n\tisSimulating = true\n\tprint(string.format(\"[FlightManager] Starting flight along %d waypoints.\", #waypoints))\nend)\n\nStopFlightEvent.OnServerEvent:Connect(function()\n\t-- Keep the heartbeat running so show drones fly back to their slots instead of teleporting\n\tShowPlayer.stop()\n\tprint(\"[FlightManager] Simulation stopped. Landing drones.\")\n\tfor _, drone in pairs(activeDrones) do\n\t\tif drone.Id == 1 then\n\t\t\tcontinue -- flown client-side by the Autopilot (DronePilotController), which lands it itself\n\t\tend\n\t\t-- Return to the spawn grid beside the pad (flat ground there, unlike under the formation)\n\t\tlocal pad = DroneConfig.HOME.SIM_POSITION\n\t\tlocal slot = drone.Id - 2\n\t\tlocal groundPos = pad + Vector3.new(8 + (slot % 10) * 3, 0, math.floor(slot / 10) * 3)\n\t\tdrone.TargetPos = groundPos\n\t\tdrone.DelayRemaining = 0\n\tend\nend)\n\n-- Export Mission to Client\nExportDataFunction.OnServerInvoke = function(player, formatType: string)\n\tif #currentWaypoints < 2 then\n\t\treturn \"Hata: D\u0131\u015fa aktar\u0131lacak aktif bir rota bulunamad\u0131. L\u00fctfen \u00f6nce waypoint ekleyin.\"\n\tend\n\n\tlocal mission = DataExporter.generateMissionFromPath(1, currentWaypoints)\n\tif formatType == \"CSV\" then\n\t\treturn DataExporter.exportToCSV(mission)\n\telse\n\t\treturn DataExporter.exportToJSON(mission)\n\tend\nend\n\n-- Live drone-to-drone separation over every swarm/show drone except Drone_001 (client-flown), 2 Hz.\n-- Published as DroneSwarm attributes MinSeparationM / ClosePairs for the HUD.\nlocal sepClock = 0\nmonitorSeparation = function(dt: number)\n\tsepClock += dt\n\tif sepClock < 0.5 then\n\t\treturn\n\tend\n\tsepClock = 0\n\tlocal positions = ShowPlayer.positions()\n\tfor id, drone in pairs(activeDrones) do\n\t\tif id ~= 1 then\n\t\t\ttable.insert(positions, drone.CurrentPos)\n\t\tend\n\tend\n\tif #positions < 2 then\n\t\tSwarmFolder:SetAttribute(\"MinSeparationM\", nil)\n\t\treturn\n\tend\n\tlocal best, close = ShowPlayer.separation(positions, DroneConfig.SWARM.MIN_SEPARATION_M)\n\tSwarmFolder:SetAttribute(\"MinSeparationM\", if best < math.huge then best else nil)\n\tSwarmFolder:SetAttribute(\"ClosePairs\", close)\nend\n\n-- Swarm Movement Heartbeat Loop (60 FPS kinematic path solver)\nlocal elapsedTime = 0\nRunService.Heartbeat:Connect(function(dt: number)\n\tif not isSimulating then\n\t\treturn\n\tend\n\n\telapsedTime += dt\n\tShowPlayer.step(dt)\n\tmonitorSeparation(dt)\n\n\t-- Batch move collection for maximum engine performance\n\tlocal partsToMove: { BasePart } = {}\n\tlocal targetCFrames: { CFrame } = {}\n\n\tfor id, drone in pairs(activeDrones) do\n\t\tif drone.DelayRemaining > 0 then\n\t\t\tdrone.DelayRemaining -= dt\n\t\t\tcontinue\n\t\tend\n\n\t\tlocal delta = (drone.TargetPos - drone.CurrentPos)\n\t\tlocal dist = delta.Magnitude\n\n\t\tif dist > 0.05 then\n\t\t\tlocal step = math.min(dist, drone.Speed * dt)\n\t\t\tlocal dir = delta.Unit\n\t\t\tdrone.CurrentPos += dir * step\n\n\t\t\t-- Bank tilt and forward rotation\n\t\t\tlocal lookAt = drone.CurrentPos + (if dir.Magnitude > 0.1 then Vector3.new(dir.X, 0, dir.Z) else Vector3.new(0, 0, -1))\n\t\t\tlocal baseCF = CFrame.lookAt(drone.CurrentPos, lookAt)\n\t\t\tlocal tiltCF = FlightMath.computeDroneTilt(dir * drone.Speed, dir * 5, baseCF)\n\t\t\tlocal finalCF = baseCF * tiltCF\n\n\t\t\ttable.insert(partsToMove, drone.Model.PrimaryPart :: BasePart)\n\t\t\ttable.insert(targetCFrames, finalCF)\n\t\tend\n\tend\n\n\tif #partsToMove > 0 then\n\t\tWorkspace:BulkMoveTo(partsToMove, targetCFrames, Enum.BulkMoveMode.FireCFrameChanged)\n\tend\nend)\n\nprint(\"[FlightManager] Drone Swarm Flight Coordinator successfully initialized.\")\n"
    s.Parent = parent
    print("[DroneInstaller] Installed FlightManager (Script)")
end

do
    local parent = game:GetService("ServerScriptService"):WaitForChild("DroneSystem")
    local existing = parent:FindFirstChild("WeatherService")
    if existing then existing:Destroy() end
    local s = Instance.new("Script")
    s.Name = "WeatherService"
    s.Source = "--!strict\n-- WeatherService.server.luau\n-- Publishes the current wind at the simulation site to ReplicatedStorage.Weather (attributes),\n-- which WindModel turns into gusty wind at the drone's altitude. Sources, best first:\n--   1. METAR \u2014 observed wind at the nearest airport (aviationweather.gov, LTBA ~3 km away)\n--   2. MET Norway locationforecast \u2014 model forecast for the exact spot, current hour\n--   3. Open-Meteo \u2014 model forecast (often rate-limited from shared IPs)\n--   4. DroneConfig.WEATHER.MANUAL\n-- Requires \"Allow HTTP Requests\" (Game Settings > Security); otherwise falls back to MANUAL.\n\nlocal HttpService = game:GetService(\"HttpService\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal DroneConfig = require(ReplicatedStorage:WaitForChild(\"DroneConfig\"))\n\nlocal W = DroneConfig.WEATHER\nlocal KNOT = 0.514444\n\ntype Reading = { SpeedMs: number, FromDeg: number, GustMs: number, TempC: number?, Source: string, Station: string, ObservedAt: string }\n\nlocal weather = Instance.new(\"Configuration\")\nweather.Name = \"Weather\"\nweather.Parent = ReplicatedStorage\n\nlocal function get(url: string): any\n\tlocal response = HttpService:RequestAsync({ Url = url, Method = \"GET\" })\n\tif not response.Success then\n\t\terror(string.format(\"HTTP %d\", response.StatusCode))\n\tend\n\treturn HttpService:JSONDecode(response.Body)\nend\n\nlocal function distanceKm(lat1: number, lon1: number, lat2: number, lon2: number): number\n\tlocal r = 6371\n\tlocal dLat, dLon = math.rad(lat2 - lat1), math.rad(lon2 - lon1)\n\tlocal a = math.sin(dLat / 2) ^ 2 + math.cos(math.rad(lat1)) * math.cos(math.rad(lat2)) * math.sin(dLon / 2) ^ 2\n\treturn 2 * r * math.asin(math.sqrt(a))\nend\n\nlocal function fromMetar(lat: number, lon: number): Reading\n\tlocal list = get(\"https://aviationweather.gov/api/data/metar?format=json&ids=\" .. table.concat(W.METAR_STATIONS, \",\"))\n\tfor _, id in ipairs(W.METAR_STATIONS) do\n\t\tfor _, m in ipairs(list) do\n\t\t\tif m.icaoId == id and type(m.wspd) == \"number\" then\n\t\t\t\tlocal ageMin = (DateTime.now().UnixTimestamp - (m.obsTime or 0)) / 60\n\t\t\t\tif ageMin <= W.METAR_MAX_AGE_MIN then\n\t\t\t\t\treturn {\n\t\t\t\t\t\tSpeedMs = m.wspd * KNOT,\n\t\t\t\t\t\tFromDeg = if type(m.wdir) == \"number\" then m.wdir else -1, -- \"VRB\" = variable\n\t\t\t\t\t\tGustMs = if type(m.wgst) == \"number\" then m.wgst * KNOT else 0,\n\t\t\t\t\t\tTempC = m.temp,\n\t\t\t\t\t\tSource = \"METAR (\u00f6l\u00e7\u00fcm)\",\n\t\t\t\t\t\tStation = string.format(\"%s \u00b7 %.1f km\", id, distanceKm(lat, lon, m.lat, m.lon)),\n\t\t\t\t\t\tObservedAt = m.reportTime or \"\",\n\t\t\t\t\t}\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\terror(\"g\u00fcncel METAR yok\")\nend\n\nlocal function fromMetNorway(lat: number, lon: number): Reading\n\tlocal d = get(string.format(\"https://api.met.no/weatherapi/locationforecast/2.0/complete?lat=%.4f&lon=%.4f\", lat, lon))\n\tlocal ts = d.properties.timeseries[1]\n\tlocal details = ts.data.instant.details\n\treturn {\n\t\tSpeedMs = details.wind_speed,\n\t\tFromDeg = details.wind_from_direction,\n\t\tGustMs = details.wind_speed_of_gust or 0,\n\t\tTempC = details.air_temperature,\n\t\tSource = \"MET Norway (tahmin)\",\n\t\tStation = \"model\",\n\t\tObservedAt = ts.time,\n\t}\nend\n\nlocal function fromOpenMeteo(lat: number, lon: number): Reading\n\tlocal d = get(string.format(\n\t\t\"https://api.open-meteo.com/v1/forecast?latitude=%.4f&longitude=%.4f&current=wind_speed_10m,wind_direction_10m,wind_gusts_10m,temperature_2m&wind_speed_unit=ms\",\n\t\tlat, lon))\n\tlocal c = d.current\n\treturn {\n\t\tSpeedMs = c.wind_speed_10m,\n\t\tFromDeg = c.wind_direction_10m,\n\t\tGustMs = c.wind_gusts_10m or 0,\n\t\tTempC = c.temperature_2m,\n\t\tSource = \"Open-Meteo (tahmin)\",\n\t\tStation = \"model\",\n\t\tObservedAt = c.time,\n\t}\nend\n\nlocal function manual(reason: string): Reading\n\treturn {\n\t\tSpeedMs = W.MANUAL.SPEED_MS,\n\t\tFromDeg = W.MANUAL.FROM_DEG,\n\t\tGustMs = W.MANUAL.GUST_MS,\n\t\tTempC = nil,\n\t\tSource = \"MANUEL (\" .. reason .. \")\",\n\t\tStation = \"-\",\n\t\tObservedAt = \"\",\n\t}\nend\n\nlocal function publish(r: Reading, errors: { string })\n\tweather:SetAttribute(\"SpeedMs\", r.SpeedMs)\n\tweather:SetAttribute(\"FromDeg\", r.FromDeg)\n\tweather:SetAttribute(\"GustMs\", r.GustMs)\n\tweather:SetAttribute(\"TempC\", r.TempC)\n\tweather:SetAttribute(\"Source\", r.Source)\n\tweather:SetAttribute(\"Station\", r.Station)\n\tweather:SetAttribute(\"ObservedAt\", r.ObservedAt)\n\tweather:SetAttribute(\"FetchedAt\", DateTime.now():ToIsoDate())\n\tweather:SetAttribute(\"Errors\", table.concat(errors, \" | \"))\n\tprint(string.format(\"[WeatherService] %s %s: %.1f m/s from %s\u00b0, gust %.1f m/s%s\", r.Source, r.Station, r.SpeedMs,\n\t\tif r.FromDeg >= 0 then string.format(\"%03d\", math.round(r.FromDeg) % 360) else \"VRB\", r.GustMs,\n\t\tif #errors > 0 then \"  (atlanan: \" .. table.concat(errors, \" | \") .. \")\" else \"\"))\nend\n\nlocal function refresh()\n\tif W.MODE ~= \"LIVE\" or not W.GEO then\n\t\tpublish(manual(if W.MODE ~= \"LIVE\" then \"ayar\" else \"konum yok\"), {})\n\t\treturn\n\tend\n\tlocal lat, lon = W.GEO[1], W.GEO[2]\n\tlocal errors = {}\n\tfor _, source in ipairs({ { \"METAR\", fromMetar }, { \"MET\", fromMetNorway }, { \"Open-Meteo\", fromOpenMeteo } }) do\n\t\tlocal ok, result = pcall((source[2] :: any), lat, lon)\n\t\tif ok then\n\t\t\tpublish(result, errors)\n\t\t\treturn\n\t\tend\n\t\tlocal message = tostring(result):gsub(\"^.-:%d+: \", \"\") -- drop the script path prefix\n\t\ttable.insert(errors, (source[1] :: string) .. \": \" .. message)\n\tend\n\tpublish(manual(\"\u00e7evrimd\u0131\u015f\u0131\"), errors)\nend\n\npublish(manual(\"ba\u015flat\u0131l\u0131yor\"), {})\ntask.spawn(function()\n\twhile true do\n\t\trefresh()\n\t\ttask.wait(W.REFRESH_SEC)\n\tend\nend)\n"
    s.Parent = parent
    print("[DroneInstaller] Installed WeatherService (Script)")
end

do
    local parent = game:GetService("ServerScriptService"):WaitForChild("DroneSystem")
    local existing = parent:FindFirstChild("BridgeLink")
    if existing then existing:Destroy() end
    local s = Instance.new("Script")
    s.Name = "BridgeLink"
    s.Source = "--!strict\n-- BridgeLink.server.luau\n-- Relays the drone state between the client (where the drone is simulated) and the local MAVLink\n-- bridge (tools/mavlink_bridge.py), and delivers ground-station commands back to the client.\n--   client --BridgeState--> server --HTTP POST (5 Hz)--> bridge --MAVLink UDP--> TEI GCS / QGC\n--   client <--BridgeCommands-- server <------ commands ------ bridge <------ GCS\n-- Only works in Studio (the bridge listens on 127.0.0.1) with \"Allow HTTP Requests\" enabled.\n\nlocal HttpService = game:GetService(\"HttpService\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal DroneConfig = require(ReplicatedStorage:WaitForChild(\"DroneConfig\"))\n\nlocal B = DroneConfig.BRIDGE\nlocal network = ReplicatedStorage:WaitForChild(\"DroneNetwork\")\n\nlocal stateEvent = Instance.new(\"RemoteEvent\")\nstateEvent.Name = \"BridgeState\"\nstateEvent.Parent = network\n\nlocal commandEvent = Instance.new(\"RemoteEvent\")\ncommandEvent.Name = \"BridgeCommands\"\ncommandEvent.Parent = network\n\n-- Link status for the HUD\nlocal status = Instance.new(\"Configuration\")\nstatus.Name = \"Bridge\"\nstatus:SetAttribute(\"Status\", \"KAPALI\")\nstatus:SetAttribute(\"GcsConnected\", false)\nstatus.Parent = ReplicatedStorage\n\nlocal latestState: { [string]: any }? = nil\nlocal latestPlayer: Player? = nil\n\nstateEvent.OnServerEvent:Connect(function(player: Player, state: any)\n\tif type(state) == \"table\" then\n\t\tlatestState = state\n\t\tlatestPlayer = player\n\tend\nend)\n\nlocal function setStatus(text: string, gcs: boolean)\n\tif status:GetAttribute(\"Status\") ~= text then\n\t\tprint(\"[BridgeLink] \" .. text)\n\tend\n\tstatus:SetAttribute(\"Status\", text)\n\tstatus:SetAttribute(\"GcsConnected\", gcs)\nend\n\ntask.spawn(function()\n\twhile true do\n\t\tlocal interval = 1 / B.RATE_HZ\n\t\tlocal state, player = latestState, latestPlayer\n\t\tif not B.ENABLED then\n\t\t\tsetStatus(\"KAPALI (ayar)\", false)\n\t\t\tinterval = 5\n\t\telseif not HttpService.HttpEnabled then\n\t\t\tsetStatus(\"KAPALI (HTTP izni yok)\", false)\n\t\t\tinterval = 5\n\t\telseif state and player then\n\t\t\tlocal ok, response = pcall(function()\n\t\t\t\treturn HttpService:RequestAsync({\n\t\t\t\t\tUrl = B.URL,\n\t\t\t\t\tMethod = \"POST\",\n\t\t\t\t\tHeaders = { [\"Content-Type\"] = \"application/json\" },\n\t\t\t\t\tBody = HttpService:JSONEncode(state),\n\t\t\t\t})\n\t\t\tend)\n\t\t\tif ok and response.Success then\n\t\t\t\tlocal reply = HttpService:JSONDecode(response.Body)\n\t\t\t\tif reply.commands and #reply.commands > 0 and player.Parent then\n\t\t\t\t\tcommandEvent:FireClient(player, reply.commands)\n\t\t\t\tend\n\t\t\t\tlocal gcs = reply.gcs_connected == true\n\t\t\t\tsetStatus(if gcs then \"BA\u011eLI \u00b7 yer istasyonu ba\u011fl\u0131\" else \"BA\u011eLI \u00b7 yer istasyonu bekleniyor\", gcs)\n\t\t\telse\n\t\t\t\tsetStatus(\"K\u00d6PR\u00dc YOK (python tools/mavlink_bridge.py)\", false)\n\t\t\t\tinterval = B.RETRY_SEC\n\t\t\tend\n\t\tend\n\t\ttask.wait(interval)\n\tend\nend)\n"
    s.Parent = parent
    print("[DroneInstaller] Installed BridgeLink (Script)")
end

